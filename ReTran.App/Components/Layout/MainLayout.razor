@inherits LayoutComponentBase
@implements IDisposable
@using ReTran_App.Services
@using ReTran_App.Services.Update
@inject ToastService Toast
@inject UpdateCheckService UpdateCheck
@inject UpdateCoordinator Coordinator
@inject I18nService L
@inject ReTran_App.Core.PipelineController Pipeline
@inject JsInteropService Js
@inject IAppUpdateService Updates
@inject IJSRuntime JS

<div class="rt-app @(_running ? "is-live" : "")">
    <header class="rt-topbar">
        <div class="rt-brand">
            <svg class="rt-brand-mark" viewBox="0 0 128 128" aria-hidden="true">
                <rect width="128" height="128" rx="24" fill="#07201E" />
                <path d="M95.112 95.112A44 44 0 1 1 95.112 32.888" fill="none" stroke="#FFB020" stroke-width="6" stroke-linecap="round" />
                <path d="M39 94V41Q39 37 42 34L48 28Q51 25 54 29L94 86Q98 92 90 92H78L56 61V78H71Q75 78 77 82L82 90Q85 94 79 94Z" fill="#EFEAD9" />
                <path d="M51 27L94 86Q98 92 90 92H78L56 61L61 47Z" fill="#C7CEC4" />
                <path d="M56 78H71Q75 78 77 82L82 90Q85 94 79 94H69L64 86H56Z" fill="#FFB020" />
            </svg>
            <span class="rt-brand-name">ReTran</span>
            <span class="rt-brand-sub rt-mono">@(L["deck.brand.sub"])</span>
        </div>

        <div class="rt-top-right">
            @if (_errorReason is not null && !_running)
            {
                <span class="rt-chip error" title="@(L.Fmt("deck.status.error", _errorReason))">
                    <span class="rt-lamp"></span><span class="rt-txt">@(L["deck.chip.error"])</span>
                </span>
            }
            else
            {
                <span class="rt-chip @(_running ? "live" : "")">
                    <span class="rt-lamp"></span>
                    <span class="rt-txt">@(_running ? L["deck.chip.live"] : L["deck.chip.stopped"])</span>
                </span>
            }

            @if (UpdateCheck.IsUpdateAvailable)
            {
                <button type="button" class="rt-chip live" title="@(L["update.badge"])" @onclick="OpenSettings">
                    <span class="rt-lamp"></span><span class="rt-txt">@(L["update.badge"])</span>
                </button>
            }

            <button type="button" class="rt-btn rt-mini" title="@(L["deck.lang.toggle"])" @onclick="ToggleLangAsync">
                @(L.Lang.ToUpperInvariant())
            </button>

            <button type="button" class="rt-icon-btn" title="@(L["deck.theme.toggle"])" aria-label="@(L["deck.theme.toggle"])" @onclick="ToggleThemeAsync">
                <svg class="rt-i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
                <svg class="rt-i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>

            <button type="button" class="rt-btn rt-btn-ghost" @onclick="OpenProfiles">
                <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
                <span class="rt-settings-label">@(L["profiles.open"])</span>
            </button>

            <button type="button" class="rt-btn rt-btn-ghost" @onclick="OpenSettings">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.11-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.6 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.14.38.4.7.75.94"/></svg>
                <span class="rt-settings-label">@(L["deck.settings.open"])</span>
            </button>

            <span class="rt-ver rt-mono">v@_appVersion</span>
        </div>
    </header>

    <main class="rt-shell">
        @Body
    </main>

    <footer class="rt-statusline">
        <span class="rt-dot @StatusDotClass"></span>
        <span>@StatusText</span>
        <span class="rt-grow"></span>
        <span class="rt-kv">@(L["deck.status.os"])</span>
    </footer>

    @* Modal update toàn màn hình — tự render rỗng khi không có update đang chạy *@
    <UpdateModal />

    @* Modal setup chạy lần đầu — tự trigger trong OnInitialized, render rỗng khi wizard đã xong (spec §5.9) *@
    <SetupModal />

    @* Start local LLM từ Home hoặc floating menu đều đi qua cùng concrete controller. *@
    <LlmStartupModal Pipeline="Pipeline" />

    @* Toast stack: fixed góc dưới phải, z-index cao để nổi trên nội dung *@
    <div class="rt-toasts" aria-live="polite">
        @foreach (var toast in _toasts)
        {
            <div class="rt-toast @(toast.Severity == ToastSeverity.Error ? "err" : "")" @key="toast.Id">
                @toast.Message
            </div>
        }
    </div>
</div>

<div class="rt-backdrop @(_settingsOpen ? "open" : "")" @onclick="CloseSettings"></div>
<aside class="rt-sheet @(_settingsOpen ? "open" : "")" id="settings-sheet" role="dialog" aria-modal="true"
       aria-labelledby="settings-sheet-title" aria-hidden="@(!_settingsOpen)" tabindex="-1"
       @ref="_sheetRef" @onkeydown="OnSheetKeyDown">
    <div class="rt-sheet-head">
        <h2 id="settings-sheet-title">@(L["deck.settings.title"])</h2>
        <button type="button" class="rt-icon-btn" aria-label="@(L["deck.settings.close"])" @onclick="CloseSettings">
            <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <div class="rt-sheet-body">
        <SettingsPanel @key="_sheetGeneration" />
    </div>
</aside>

<div class="rt-backdrop @(_profilesOpen ? "open" : "")" @onclick="CloseProfiles"></div>
<aside class="rt-sheet @(_profilesOpen ? "open" : "")" id="profiles-sheet" role="dialog" aria-modal="true"
       aria-labelledby="profiles-sheet-title" aria-hidden="@(!_profilesOpen)" tabindex="-1"
       @ref="_profilesSheetRef" @onkeydown="OnProfilesSheetKeyDown">
    <div class="rt-sheet-head">
        <h2 id="profiles-sheet-title">@(L["profiles.title"])</h2>
        <button type="button" class="rt-icon-btn" aria-label="@(L["profiles.close"])" @onclick="CloseProfiles">
            <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
    </div>
    <div class="rt-sheet-body">
        <ProfilesPanel @key="_profilesGeneration" />
    </div>
</aside>

@code {
    private readonly List<ToastItem> _toasts = [];
    private string _appVersion = string.Empty;
    private bool _running;
    private string? _errorReason;
    private bool _settingsOpen;
    private int _sheetGeneration;
    private bool _focusSheet;
    private ElementReference _sheetRef;
    private bool _profilesOpen;
    private int _profilesGeneration;
    private bool _focusProfilesSheet;
    private ElementReference _profilesSheetRef;

    private string StatusDotClass => _errorReason is not null && !_running ? "error" : _running ? "" : "idle";

    private string StatusText => _errorReason is not null && !_running
        ? L.Fmt("deck.status.error", _errorReason)
        : _running ? L["deck.status.live"] : L["deck.status.ready"];

    protected override void OnInitialized()
    {
        _appVersion = AppVersionFormatter.Format(Updates.CurrentVersion);
        _running = Pipeline.IsRunning;
        Toast.ToastAdded += OnToastAdded;
        UpdateCheck.UpdateFound += OnUpdateFound;
        UpdateCheck.StateChanged += OnStateChanged;
        Coordinator.Failed += OnUpdateFailed;
        Coordinator.Cancelled += OnUpdateCancelled;
        Pipeline.PipelineStateChanged += OnPipelineStateChanged;
        Pipeline.StateChanged += OnPipelineStateChanged2;
        L.Changed += OnStateChanged;
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // JS bridge thuộc app shell: topbar và settings sheet dùng được ở mọi route.
            Js.Initialize(JS);
            Js.NotifyWebViewReady();
            _ = InitLangFromStorageAsync();
        }

        if (_focusSheet)
        {
            _focusSheet = false;
            _ = FocusSheetAsync();
        }

        if (_focusProfilesSheet)
        {
            _focusProfilesSheet = false;
            _ = FocusProfilesSheetAsync();
        }

        base.OnAfterRender(firstRender);
    }

    private async Task FocusSheetAsync()
    {
        try
        {
            await _sheetRef.FocusAsync();
        }
        catch (Exception)
        {
            // WebView chưa sẵn sàng — focus là best-effort.
        }
    }

    private async Task FocusProfilesSheetAsync()
    {
        try
        {
            await _profilesSheetRef.FocusAsync();
        }
        catch (Exception)
        {
            // WebView chưa sẵn sàng — focus là best-effort.
        }
    }

    private async Task InitLangFromStorageAsync()
    {
        try
        {
            var stored = await Js.GetLangAsync();
            if (stored is "vi" or "en" && stored != L.Lang)
            {
                L.Set(stored);
            }
        }
        catch (Exception)
        {
            // JS/storage unavailable → keep the OS-culture default.
        }
    }

    private void OpenSettings()
    {
        _profilesOpen = false;
        _settingsOpen = true;
        _sheetGeneration++;
        _focusSheet = true;
    }

    private void CloseSettings() => _settingsOpen = false;

    private void OnSheetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseSettings();
    }

    private void OpenProfiles()
    {
        _settingsOpen = false;
        _profilesOpen = true;
        _profilesGeneration++;
        _focusProfilesSheet = true;
    }

    private void CloseProfiles() => _profilesOpen = false;

    private void OnProfilesSheetKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseProfiles();
    }

    private async Task ToggleLangAsync()
    {
        string lang = L.Lang == "vi" ? "en" : "vi";
        L.Set(lang);
        try
        {
            await Js.SetLangAsync(lang);
        }
        catch (Exception)
        {
            // Lưu thất bại không ảnh hưởng ngôn ngữ đã áp trong RAM.
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            await Js.ToggleThemeAsync();
        }
        catch (Exception)
        {
            // Không đổi được theme không phá UI.
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnToastAdded(ToastItem item) => _ = InvokeAsync(async () =>
    {
        _toasts.Add(item);
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(4));
        _toasts.Remove(item);
        StateHasChanged();
    });

    // UpdateFound bắn từ luồng nền của UpdateCheckService — marshal về UI thread
    private void OnUpdateFound(ReleaseInfo release) => _ = InvokeAsync(() =>
        Toast.Show(string.Format(L["update.available"], release.TagName)));

    // Cả 4 loại lỗi (UpdateError) đều toast kèm lý do — chi tiết đầy đủ đã vào Logs (spec §11)
    private void OnUpdateFailed(UpdateError error) => _ = InvokeAsync(() =>
    {
        var reason = error switch
        {
            UpdateError.DownloadFailed => L["update.error.download"],
            UpdateError.VerifyFailed => L["update.error.verify"],
            UpdateError.StopServicesFailed => L["update.error.stop"],
            UpdateError.InstallFailed => L["update.error.install"],
            _ => L["update.error.install"],
        };
        Toast.Show(string.Format(L["update.failed"], reason), ToastSeverity.Error);
    });

    private void OnUpdateCancelled() => _ = InvokeAsync(() =>
        Toast.Show(L["update.cancelled"]));

    // PipelineStateChanged nổ trên read-loop thread — marshal về renderer trước khi re-render.
    private void OnPipelineStateChanged(bool running, string? reason) => _ = InvokeAsync(() =>
    {
        _running = running;
        if (running) _errorReason = null;
        else if (reason is not null) _errorReason = reason;
        StateHasChanged();
    });

    // Start/Stop do người dùng bấm không bắn PipelineStateChanged — StateChanged giữ topbar đồng bộ.
    private void OnPipelineStateChanged2() => _ = InvokeAsync(() =>
    {
        _running = Pipeline.IsRunning;
        if (_running) _errorReason = null;
        StateHasChanged();
    });

    public void Dispose()
    {
        Toast.ToastAdded -= OnToastAdded;
        UpdateCheck.UpdateFound -= OnUpdateFound;
        UpdateCheck.StateChanged -= OnStateChanged;
        Coordinator.Failed -= OnUpdateFailed;
        Coordinator.Cancelled -= OnUpdateCancelled;
        Pipeline.PipelineStateChanged -= OnPipelineStateChanged;
        Pipeline.StateChanged -= OnPipelineStateChanged2;
        L.Changed -= OnStateChanged;
    }
}
