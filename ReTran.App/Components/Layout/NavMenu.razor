@using ReTran_App.Services.Update
@inject ReTran_App.Services.I18nService L
@inject IAppUpdateService Updates
@inject UpdateCheckService UpdateCheck
@implements IDisposable

<div class="p-4">
    <a class="text-xl font-bold text-primary no-underline" href="">ReTran</a>
</div>

<nav class="flex-1 p-2">
    <NavLink class="flex items-center gap-3 px-4 py-2.5 rounded text-surface hover:bg-primary hover:text-light no-underline mb-1"
             href="" Match="NavLinkMatch.All">
        <span class="w-5 text-center">&#9654;</span>
        <span>@(L["nav.control"])</span>
    </NavLink>
    <NavLink class="flex items-center gap-3 px-4 py-2.5 rounded text-surface hover:bg-primary hover:text-light no-underline mb-1"
             href="settings">
        <span class="w-5 text-center">&#9881;</span>
        <span>@(L["nav.settings"])</span>
    </NavLink>
</nav>

<div class="p-3 text-xs text-secondary">
    <span>Windows - v@_appVersion</span>
    @if (UpdateFeature.IsEnabled && UpdateCheck.IsUpdateAvailable)
    {
        <span class="ml-1 rounded-full bg-warning px-2 py-0.5 text-xs">@(L["update.badge"])</span>
    }
</div>

@code {
    private string _appVersion = string.Empty;

    protected override void OnInitialized()
    {
        _appVersion = AppVersionFormatter.Format(Updates.CurrentVersion);
        L.Changed += OnStateChanged;
        UpdateCheck.StateChanged += OnStateChanged;
        base.OnInitialized();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.Changed -= OnStateChanged;
        UpdateCheck.StateChanged -= OnStateChanged;
    }
}
