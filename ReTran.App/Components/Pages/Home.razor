@page "/"
@using ReTran_App.Core
@using ReTran_App.Services
@inject ReTran_App.Core.OverlayState State
@inject ReTran_App.Services.OverlayFeedServer FeedServer
@inject ReTran_App.Services.JsInteropService Js
@inject ReTran_App.Services.I18nService L
@inject ReTran_App.Services.AppSettingsService Settings
@inject ReTran_App.Core.PipelineController Pipeline
@inject ReTran_App.Services.OverlayWindow.OverlayWindowService OverlaySvc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@(L["page.control.title"])</PageTitle>

<div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-surface m-0">@(L["home.title"])</h1>
</div>

<div class="space-y-4">
    <Card Title="@(L["home.card.pipeline"])">
        <div class="flex items-center gap-3 flex-wrap">
            <span class="px-2 py-1 rounded border text-sm font-medium @(BadgeClass)">@BadgeSymbol @BadgeText</span>
        </div>

        <label class="flex flex-col gap-1.5 text-sm text-surface">
            @(L["home.label.screen"])
            <select @bind="_monitorId" class="w-full px-3 py-2 border rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary">
                @if (_monitors.Count == 0)
                {
                    <option value="">…</option>
                }
                else
                {
                @foreach (MonitorInfo m in _monitors)
                {
                    <option value="@m.Id">@(L.Fmt("home.opt.monitorFormat", m.Id))</option>
                }
                }
            </select>
        </label>

        <label class="flex flex-col gap-1.5 text-sm text-surface">
            @(L["home.label.window"])
            <select @bind="_windowHwnd" class="w-full px-3 py-2 border rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary">
                <option value="">@(L["home.opt.pickWindow"])</option>
                @foreach (WindowInfo w in _windows)
                {
                    <option value="@w.Hwnd">@(L.Fmt("home.opt.windowFormat", w.Title, w.Process))</option>
                }
            </select>
        </label>

        <div class="flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick="RefreshSources">@(L["home.btn.refreshSources"])</button>
            <button class="btn btn-primary" @onclick="StartPipelineAsync">@(L["home.btn.start"])</button>
            <button class="btn btn-outline-secondary" @onclick="StopPipelineAsync">@(L["home.btn.stop"])</button>
        </div>

        @if (_pipelineError is not null)
        {
            <p class="text-sm text-danger">@_pipelineError</p>
        }

        <p class="text-sm text-secondary">@(L["home.note.capture"])</p>
    </Card>

    <Card Title="@(L["overlay.title"])">
        <div class="flex items-center gap-2">
            <input id="overlay-toggle" type="checkbox" class="w-4 h-4" @bind="_overlayOn" @bind:after="ToggleOverlay" disabled="@(Pipeline.ActiveSource is null)" />
            <label for="overlay-toggle" class="text-sm text-surface">@(L["overlay.toggle"])</label>
        </div>

        <label class="flex flex-col gap-1.5 text-sm text-surface">
            @(L["overlay.mode.label"])
            <select @bind="_overlayMode" @bind:after="ApplyOverlayMode" class="w-full px-3 py-2 border rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary">
                <option value="subtitle">@(L["overlay.mode.subtitle"])</option>
                <option value="panel">@(L["overlay.mode.panel"])</option>
            </select>
        </label>

        @if (_overlayMode == "panel")
        {
            <label class="flex flex-col gap-1.5 text-sm text-surface">
                @(L["overlay.corner.label"])
                <select @bind="_overlayCorner" @bind:after="ApplyOverlayCorner" class="w-full px-3 py-2 border rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary">
                    <option value="tl">@(L["overlay.corner.tl"])</option>
                    <option value="tr">@(L["overlay.corner.tr"])</option>
                    <option value="bl">@(L["overlay.corner.bl"])</option>
                    <option value="br">@(L["overlay.corner.br"])</option>
                </select>
            </label>
        }

        <div class="flex gap-2 flex-wrap items-center">
            <span class="text-sm text-surface">@(L["overlay.font.label"])</span>
            <button class="@(FontBtnClass(0.85))" @onclick='() => SetOverlayFont(0.85)'>@(L["overlay.font.small"])</button>
            <button class="@(FontBtnClass(1.0))" @onclick='() => SetOverlayFont(1.0)'>@(L["overlay.font.medium"])</button>
            <button class="@(FontBtnClass(1.25))" @onclick='() => SetOverlayFont(1.25)'>@(L["overlay.font.large"])</button>
        </div>

        <p class="text-sm text-secondary">@(L["overlay.note.fullscreen"])</p>
    </Card>

    <Card Title="@(L["home.card.translation"])">
        <label class="flex flex-col gap-1.5 text-sm text-surface">
            @(L["home.label.quickDst"])
            <select @bind="_quickDst" @bind:after="SaveQuickDst" class="w-full px-3 py-2 border rounded bg-background text-surface focus:outline-none focus:ring-2 focus:ring-primary">
                @foreach (string lang in _dstOptions)
                {
                    <option value="@lang">@(I18nStrings.LanguageName(lang))</option>
                }
            </select>
        </label>
        <p class="text-sm text-secondary">@(L["settings.note.srcNextStart"])</p>
    </Card>

    <Card Title="Demo pipeline">
        <div class="flex gap-2 flex-wrap">
            <button class="btn btn-primary" @onclick="StartDemo" disabled="@_running">@(L["home.btn.startDemo"])</button>
            <button class="btn btn-outline-secondary" @onclick="StopDemo" disabled="@(!_running)">@(L["home.btn.stopDemo"])</button>
        </div>
        <p class="text-sm text-secondary">@StatusText</p>
    </Card>

    <Card Title="OBS">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-sm text-surface">@(L["home.label.obsUrl"])</span>
            <code class="px-2 py-1 rounded bg-background border text-sm text-surface break-all">@ObsUrl</code>
            <button class="btn btn-outline-primary" @onclick="CopyUrlAsync">@(L["home.btn.copy"])</button>
            @if (CopyStatusText.Length > 0)
            {
                <span class="text-sm text-secondary">@CopyStatusText</span>
            }
        </div>
        @if (FeedServer.Port == 0)
        {
            <p class="text-sm text-danger">@(L["home.status.feedNotRunning"])</p>
        }
        <iframe src="@ObsUrl" title="@(L["home.iframe.title"])" class="w-full max-w-[480px] h-[270px] rounded border"></iframe>
    </Card>

    <Card Title="@(L["home.card.theme"])">
        <div class="flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick='() => SetThemeAsync("light")'>@(L["home.btn.theme.light"])</button>
            <button class="btn btn-outline-secondary" @onclick='() => SetThemeAsync("dark")'>@(L["home.btn.theme.dark"])</button>
            <button class="btn btn-outline-secondary" @onclick='() => SetThemeAsync("system")'>@(L["home.btn.theme.system"])</button>
        </div>
        <div class="flex gap-2 flex-wrap items-center">
            <span class="text-sm text-surface">@(L["home.lang.label"])</span>
            <button class="@(LangBtnClass("vi"))" @onclick='() => SetLangAsync("vi")'>VI</button>
            <button class="@(LangBtnClass("en"))" @onclick='() => SetLangAsync("en")'>EN</button>
        </div>
        <div class="flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" @onclick='() => SetColorAsync("default")' title="@(L["home.swatch.default"])"><span class="inline-block w-4 h-4 rounded-full border border-current bg-[var(--primary)]"></span> @(L["home.swatch.default"])</button>
            <button class="btn btn-outline-secondary" data-color="emerald" @onclick='() => SetColorAsync("emerald")' title="Emerald"><span class="inline-block w-4 h-4 rounded-full border border-current bg-[var(--primary)]"></span> Emerald</button>
            <button class="btn btn-outline-secondary" data-color="violet" @onclick='() => SetColorAsync("violet")' title="Violet"><span class="inline-block w-4 h-4 rounded-full border border-current bg-[var(--primary)]"></span> Violet</button>
            <button class="btn btn-outline-secondary" data-color="sunset" @onclick='() => SetColorAsync("sunset")' title="Sunset"><span class="inline-block w-4 h-4 rounded-full border border-current bg-[var(--primary)]"></span> Sunset</button>
        </div>
        @if (ThemeStatusText.Length > 0)
        {
            <span class="text-sm text-secondary">@ThemeStatusText</span>
        }
    </Card>
</div>

@code {
    private static readonly string[] DefaultDstOptions = ["vi", "en", "ja", "ko", "zh", "ru", "fr", "de", "es"];

    private IReadOnlyList<MonitorInfo> _monitors = Array.Empty<MonitorInfo>();
    private IReadOnlyList<WindowInfo> _windows = Array.Empty<WindowInfo>();
    private string _monitorId = "0";
    private string _windowHwnd = string.Empty;
    private string _quickDst = "vi";
    private string[] _dstOptions = DefaultDstOptions;
    private string _pipelineState = "stopped"; // "stopped" | "running" | "coreError"
    private string? _coreReason;
    private string? _pipelineError;
    private ReTran_App.Core.DemoFeed? _feed;
    private bool _running;
    private string? _copyState;      // "copied" | "failed" | null
    private string? _themeStateKind; // "theme" | "themeFail" | "color" | "colorFail"
    private string? _themeStateValue;
    private bool _overlayOn;
    private string _overlayMode = "subtitle";    // "subtitle" | "panel"
    private string _overlayCorner = "bl";        // "tl" | "tr" | "bl" | "br"
    private double _overlayFontScale = 1.0;

    private string ObsUrl => $"http://127.0.0.1:{FeedServer.Port}/overlay";

    private string BadgeSymbol => _pipelineState == "running" ? "●" : "■";

    // Trạng thái tính từ _pipelineState + L → tự đổi ngôn ngữ khi L.Changed.
    private string BadgeText => _pipelineState switch
    {
        "running" => L["home.status.running"],
        "coreError" => L.Fmt("home.status.coreError", _coreReason ?? string.Empty),
        _ => L["home.status.stopped"],
    };

    private string BadgeClass => _pipelineState switch
    {
        "running" => "text-primary",
        "coreError" => "text-danger",
        _ => "text-secondary",
    };

    // Trạng thái tính từ state + L → tự đổi ngôn ngữ khi L.Changed.
    private string StatusText => _running
        ? L.Fmt("home.status.demoRunning", SourceLabel())
        : L["home.status.demoStopped"];

    private string CopyStatusText => _copyState switch
    {
        "copied" => L["home.status.copied"],
        "failed" => L["home.status.copyFailed"],
        _ => string.Empty,
    };

    private string ThemeStatusText => _themeStateKind switch
    {
        "theme" => L.Fmt("home.status.theme", _themeStateValue ?? string.Empty),
        "themeFail" => L["home.status.themeFailed"],
        "color" => L.Fmt("home.status.color", _themeStateValue ?? string.Empty),
        "colorFail" => L["home.status.colorFailed"],
        _ => string.Empty,
    };

    private string LangBtnClass(string lang) =>
        L.Lang == lang ? "btn btn-primary" : "btn btn-outline-secondary";

    protected override void OnInitialized()
    {
        L.Changed += OnLangChanged;
        Pipeline.PipelineStateChanged += OnPipelineStateChanged;
        // Quay lại trang này (Home → Settings → Home) phải lấy state thật, không hardcode "stopped".
        _pipelineState = Pipeline.IsRunning ? "running" : "stopped";
        AppSettings current = Settings.Load();
        _quickDst = current.Dst;
        // File ghi tay có thể chứa dst ngoài danh sách — thêm vào để select không bị trống.
        if (Array.IndexOf(_dstOptions, _quickDst) < 0) _dstOptions = [_quickDst, .. _dstOptions];
        _overlayOn = OverlaySvc.IsEnabled; // service là nguồn sự thật (persisted flag chỉ để restore ở nơi khác)
        _overlayMode = current.OverlayMode;
        _overlayCorner = current.OverlayCorner;
        _overlayFontScale = current.OverlayFontScale;
        _ = LoadSourcesAsync();
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Nothing else initializes the JS bridge (verified: no other caller of
        // Initialize/NotifyWebViewReady), so the control page does it on first
        // render — otherwise copyText would silently no-op.
        if (firstRender)
        {
            Js.Initialize(JS);
            Js.NotifyWebViewReady();
            _ = InitLangFromStorageAsync();
        }
    }

    private async Task InitLangFromStorageAsync()
    {
        try
        {
            var stored = await Js.GetLangAsync();
            if (stored is "vi" or "en" && stored != L.Lang)
            {
                L.Set(stored);
            }
        }
        catch (Exception)
        {
            // JS/storage unavailable → keep the OS-culture default.
            // Không đọc được JS/storage → giữ mặc định theo culture OS.
        }
    }

    // Nạp danh sách màn hình/cửa sổ từ Core; lỗi → giữ placeholder, không crash UI.
    private async Task LoadSourcesAsync()
    {
        try
        {
            (IReadOnlyList<MonitorInfo> monitors, IReadOnlyList<WindowInfo> windows) =
                await Pipeline.ListSourcesAsync(CancellationToken.None);
            _monitors = monitors;
            _windows = windows;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Core chưa sẵn sàng → dropdown giữ placeholder, bấm Làm mới thử lại sau.
        }
    }

    private void RefreshSources() => _ = LoadSourcesAsync();

    private SourceSelection BuildSelection() => !string.IsNullOrEmpty(_windowHwnd)
        ? new SourceSelection(UseWindow: true, Monitor: 0, HwndHex: _windowHwnd)
        : new SourceSelection(
            UseWindow: false,
            Monitor: int.TryParse(_monitorId, out int monitor) ? monitor : 0,
            HwndHex: null);

    private async Task StartPipelineAsync()
    {
        if (_running) StopDemo(); // tránh 2 nguồn publish cùng OverlayState (plan M4)
        _pipelineError = null;
        try
        {
            await Pipeline.StartAsync(BuildSelection(), CancellationToken.None);
            _pipelineState = "running";
            _coreReason = null;
        }
        catch (Exception ex)
        {
            _pipelineError = L.Fmt("home.status.startFailed", ex.Message);
        }
    }

    private async Task StopPipelineAsync()
    {
        _pipelineError = null;
        try
        {
            await Pipeline.StopAsync(CancellationToken.None);
            _pipelineState = "stopped";
            _coreReason = null;
        }
        catch (Exception ex) // core chưa start → ICorePeer.CallAsync ném InvalidOperationException
        {
            _pipelineError = L.Fmt("home.status.stopFailed", ex.Message);
        }
    }

    // PipelineStateChanged nổ trên read-loop thread của peer → marshal về renderer trước khi re-render.
    private void OnPipelineStateChanged(bool running, string? reason) =>
        _ = InvokeAsync(() =>
        {
            if (reason == PipelineController.CoreExitedReason)
            {
                // Core chết → badge dừng, lỗi hiện dưới nút (tận dụng "Lỗi core: {0}").
                _pipelineState = "stopped";
                _pipelineError = L.Fmt("home.status.coreError", reason);
            }
            else
            {
                _pipelineState = running ? "running" : reason is null ? "stopped" : "coreError";
                _coreReason = reason;
            }
            StateHasChanged();
        });

    // Ghi ngay dst mới vào settings.json — áp dụng cho lần start kế tiếp.
    private void SaveQuickDst()
    {
        try
        {
            Settings.Save(Settings.Load() with { Dst = _quickDst });
        }
        catch (Exception)
        {
            // Ghi file fail không được phá UI — dst giữ trong RAM cho lần start sau.
        }
    }

    // Service tự persist OverlayOnGame; UI chỉ mirror IsEnabled.
    private void ToggleOverlay() => OverlaySvc.SetEnabled(_overlayOn);

    private void ApplyOverlayMode() => OverlaySvc.ApplyOptions(mode: _overlayMode);

    private void ApplyOverlayCorner() => OverlaySvc.ApplyOptions(corner: _overlayCorner);

    private void SetOverlayFont(double scale)
    {
        _overlayFontScale = scale;
        OverlaySvc.ApplyOptions(fontScale: scale);
    }

    private string FontBtnClass(double scale) =>
        _overlayFontScale == scale ? "btn btn-primary" : "btn btn-outline-secondary";

    private void OnLangChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SetLangAsync(string lang)
    {
        if (lang == L.Lang) return;
        L.Set(lang); // UI đổi ngay qua event Changed
        try
        {
            await Js.SetLangAsync(lang); // persist best-effort
        }
        catch (Exception)
        {
            // Lưu thất bại không ảnh hưởng ngôn ngữ đã áp trong RAM.
        }
    }

    private void StartDemo()
    {
        if (_feed is not null) return;
        _feed = new ReTran_App.Core.DemoFeed(State);
        _feed.Start();
        _running = true;
    }

    private void StopDemo()
    {
        if (_feed is null) return;
        _feed.Stop();
        _feed.Dispose();
        _feed = null;
        _running = false;
    }

    private string SourceLabel() => !string.IsNullOrEmpty(_windowHwnd)
        ? $"Window ({_windowHwnd})"
        : $"screen:{(int.TryParse(_monitorId, out int monitor) ? monitor : 0)}";

    private async Task CopyUrlAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("copyText", ObsUrl);
            _copyState = "copied";
        }
        catch (Exception)
        {
            _copyState = "failed";
        }
    }

    public void Dispose()
    {
        L.Changed -= OnLangChanged;
        Pipeline.PipelineStateChanged -= OnPipelineStateChanged;
        if (_feed is not null)
        {
            _feed.Stop();
            _feed.Dispose();
            _feed = null;
        }
    }

    private async Task SetThemeAsync(string theme)
    {
        try
        {
            await Js.SetThemeAsync(theme);
            _themeStateKind = "theme";
            _themeStateValue = theme;
        }
        catch (Exception)
        {
            _themeStateKind = "themeFail";
            _themeStateValue = null;
        }
    }

    private async Task SetColorAsync(string colorId)
    {
        try
        {
            await Js.SetColorAsync(colorId);
            _themeStateKind = "color";
            _themeStateValue = colorId;
        }
        catch (Exception)
        {
            _themeStateKind = "colorFail";
            _themeStateValue = null;
        }
    }
}
