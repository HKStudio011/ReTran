@page "/"
@using System.Globalization
@using ReTran_App.Core
@using ReTran_App.Services
@using ReTran_App.Services.Camera
@using ReTran_App.Services.OverlayFeed
@inject PreviewState Preview
@inject OverlayState Overlay
@inject OverlayFeedServer Feed
@inject JsInteropService Js
@inject I18nService L
@inject AppSettingsService SettingsStore
@inject PipelineController Pipeline
@inject ReTran_App.Services.OverlayWindow.OverlayWindowService OverlaySvc
@inject ToastService Toast
@implements IDisposable

<PageTitle>@(L["page.control.title"])</PageTitle>

<div class="@(_pipelineState == "running" ? "is-live" : "")">
    <div class="rt-stage">
        <section class="rt-main">
            @if (_showOcrNotice)
            {
                @* First-run: chưa có model OCR nào cài — dẫn tới mục Model OCR trong Cài đặt. *@
                <div class="rt-alert" role="alert" style="align-items: center; margin-bottom: 12px;">
                    <span style="flex: 1;"><b>@(L["deck.ocr.firstRun.title"])</b> — @(L["deck.ocr.firstRun.body"])</span>
                    <button type="button" class="rt-btn rt-mini" @onclick="DismissOcrNotice">@(L["deck.ocr.firstRun.later"])</button>
                </div>
            }
            <div class="rt-monitor">
                <div class="rt-monitor-bar">
                    <span class="rt-plate"><b>@(L["home.preview.title"])</b></span>
                    <span class="rt-sep"></span>
                    <span class="rt-mono">@FrameSizeText</span>
                    <span class="rt-mono">@FpsText</span>
                    <span class="rt-mono">@BoxText</span>
                    <span class="rt-dir rt-mono">@DirectionText</span>
                </div>

                <div class="rt-frame @(_pipelineState == "running" ? "is-live" : "")">
                    @if (_previewSrc is not null)
                    {
                        <img class="rt-frame-img" src="@_previewSrc" alt="@(L["home.preview.title"])" />
                    }
                    else
                    {
                        <div class="rt-idle">
                            <div class="rt-slate">
                                <span class="rt-glyph" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><path d="M3 7h4l2-3h6l2 3h4v12H3z"/><path d="M8 13a4 4 0 1 0 8 0 4 4 0 1 0-8 0"/></svg>
                                </span>
                                <p class="rt-slate-title">@(L["home.preview.idle"])</p>
                                <p class="rt-slate-hint">@(L.Fmt("deck.preview.idleHint", SourceDisplay))</p>
                                <button type="button" class="rt-btn rt-slate-start" disabled="@_busy" @onclick="TogglePipelineAsync">
                                    <span class="rt-ico-play"></span>
                                    <span>@(L["deck.preview.startCta"])</span>
                                </button>
                                <p class="rt-kbd-hint rt-mono">@(L["deck.preview.idleMeta"])</p>
                            </div>
                        </div>
                    }

                    <span class="rt-corner rt-c1"></span>
                    <span class="rt-corner rt-c2"></span>
                    <span class="rt-corner rt-c3"></span>
                    <span class="rt-corner rt-c4"></span>
                    <span class="rt-scan"></span>
                </div>
            </div>

            <div class="rt-transport">
                <div class="rt-field">
                    <span class="rt-lbl">@(L["deck.source.label"])</span>
                    <div class="rt-field-row">
                        <div class="rt-seg" role="group" aria-label="@(L["deck.source.label"])">
                            <button type="button" aria-pressed="@Pressed(_sourceKind == "screen")" @onclick='() => SetSourceKind("screen")'>@(L["deck.source.screen"])</button>
                            <button type="button" aria-pressed="@Pressed(_sourceKind == "window")" @onclick='() => SetSourceKind("window")'>@(L["deck.source.window"])</button>
                        </div>

                        @if (_sourceKind == "screen")
                        {
                            <div class="rt-select rt-source-select">
                                <select @bind="_monitorId" aria-label="@(L["deck.source.pick"])">
                                    @if (_monitors.Count == 0)
                                    {
                                        <option value="">…</option>
                                    }
                                    else
                                    {
                                        @foreach (MonitorInfo m in _monitors)
                                        {
                                            <option value="@m.Id">@(L.Fmt("home.opt.monitorFormat", m.Id))</option>
                                        }
                                    }
                                </select>
                                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        }
                        else
                        {
                            <div class="rt-select rt-source-select">
                                <select @bind="_windowHwnd" aria-label="@(L["deck.source.pick"])">
                                    <option value="">@(L["home.opt.pickWindow"])</option>
                                    @foreach (WindowInfo w in _windows)
                                    {
                                        <option value="@w.Hwnd">@(L.Fmt("home.opt.windowFormat", w.Title, w.Process))</option>
                                    }
                                </select>
                                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        }

                        <button type="button" class="rt-icon-btn" title="@(L["deck.source.refresh"])" aria-label="@(L["deck.source.refresh"])" @onclick="RefreshSourcesAsync">
                            <svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>
                        </button>
                    </div>
                </div>

                <div class="rt-field">
                    <span class="rt-lbl">@(L["home.label.quickDst"])</span>
                    <div class="rt-select rt-dst-select">
                        <select @bind="_quickDst" @bind:after="SaveQuickDst" aria-label="@(L["home.label.quickDst"])">
                            @foreach (string lang in _dstOptions)
                            {
                                <option value="@lang">@(I18nStrings.LanguageName(lang))</option>
                            }
                        </select>
                        <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                </div>

                <div class="rt-action">
                    <button type="button" class="rt-btn rt-btn-run @(IsRunning ? "" : "rt-btn-primary")" disabled="@_busy" @onclick="TogglePipelineAsync">
                        @if (IsRunning)
                        {
                            <span class="rt-ico-stop"></span><span>@(L["home.btn.stop"])</span>
                        }
                        else
                        {
                            <span class="rt-ico-play"></span><span>@(L["home.btn.start"])</span>
                        }
                    </button>
                    <span class="rt-hint">@RunHint</span>
                </div>
            </div>

            @if (_pipelineError is not null)
            {
                <p class="rt-alert" role="alert">@_pipelineError</p>
            }
        </section>

        <aside class="rt-rail">
            <div class="rt-rail-panel">
                <div class="rt-rail-head">
                    <h2>@(L["deck.chain.title"])</h2>
                    <span class="rt-sub rt-mono">@(L["deck.ocr.engine"]) · @ProviderShort</span>
                </div>

                <ol class="rt-chain">
                    <li class="rt-step">
                        <span class="rt-idx">01</span>
                        <div class="rt-step-body">
                            <div class="rt-step-row"><span class="rt-name">@(L["deck.chain.capture"])</span><span class="rt-step-lamp"></span></div>
                            <div class="rt-read">
                                <span>@SourceDisplay</span><span class="rt-dot">·</span><span>@FpsText</span>
                                <span class="rt-dot">·</span><span>@(_sourceKind == "window" ? L["deck.capture.printwindow"] : L["deck.capture.dxgi"])</span>
                            </div>
                        </div>
                    </li>
                    <li class="rt-step">
                        <span class="rt-idx">02</span>
                        <div class="rt-step-body">
                            <div class="rt-step-row"><span class="rt-name">@(L["deck.chain.ocr"])</span><span class="rt-step-lamp"></span></div>
                            <div class="rt-read">
                                <span>@(L["deck.ocr.engine"])</span><span class="rt-dot">·</span><span>@BoxText</span>
                            </div>
                        </div>
                    </li>
                    <li class="rt-step">
                        <span class="rt-idx">03</span>
                        <div class="rt-step-body">
                            <div class="rt-step-row"><span class="rt-name">@(L["deck.chain.translate"])</span><span class="rt-step-lamp"></span></div>
                            <div class="rt-read">
                                <span>@ProviderShort</span><span class="rt-dot">·</span><span>@DirectionText</span>
                                <span class="rt-dot">·</span><span>@LinesText</span>
                            </div>
                        </div>
                    </li>
                    <li class="rt-step">
                        <span class="rt-idx">04</span>
                        <div class="rt-step-body">
                            <div class="rt-step-row"><span class="rt-name">@(L["deck.chain.camera"])</span><span class="rt-step-lamp"></span></div>
                            <div class="rt-read">
                                <span>@CameraRegistrar.DeviceName</span><span class="rt-dot">·</span><span>@FpsText</span>
                                <span class="rt-dot">·</span><span>@(L["deck.camera.format"])</span>
                            </div>
                        </div>
                    </li>
                </ol>

                <section class="rt-rail-sec">
                    <div class="rt-sec-head">
                        <h3>@(L["deck.overlay.title"])</h3>
                        <button type="button" class="rt-switch" role="switch"
                                aria-checked="@Pressed(_overlayOn)" aria-label="@(L["deck.overlay.toggleAria"])"
                                disabled="@(!IsRunning)" @onclick="ToggleOverlay">
                            <span class="rt-knob"></span>
                        </button>
                    </div>
                    <p class="rt-sec-sub">@(L["deck.overlay.sub"])</p>

                    <div class="rt-field">
                        <span class="rt-lbl">@(L["deck.overlay.mode"])</span>
                        <div class="rt-select">
                            <select @bind="_overlayMode" @bind:after="ApplyOverlayMode" aria-label="@(L["deck.overlay.mode"])">
                                <option value="subtitle">@(L["overlay.mode.subtitle"])</option>
                                <option value="panel">@(L["overlay.mode.panel"])</option>
                            </select>
                            <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                    </div>

                    @if (_overlayMode == "panel")
                    {
                        <div class="rt-field">
                            <span class="rt-lbl">@(L["overlay.corner.label"])</span>
                            <div class="rt-select">
                                <select @bind="_overlayCorner" @bind:after="ApplyOverlayCorner" aria-label="@(L["overlay.corner.label"])">
                                    <option value="tl">@(L["overlay.corner.tl"])</option>
                                    <option value="tr">@(L["overlay.corner.tr"])</option>
                                    <option value="bl">@(L["overlay.corner.bl"])</option>
                                    <option value="br">@(L["overlay.corner.br"])</option>
                                </select>
                                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </div>
                    }

                    <div class="rt-field">
                        <span class="rt-lbl">@(L["deck.overlay.font"])</span>
                        <div class="rt-seg" role="group" aria-label="@(L["deck.overlay.font"])">
                            <button type="button" aria-pressed="@Pressed(_overlayFontScale == 0.85)" @onclick='() => SetOverlayFont(0.85)'>@(L["overlay.font.small"])</button>
                            <button type="button" aria-pressed="@Pressed(_overlayFontScale == 1.0)" @onclick='() => SetOverlayFont(1.0)'>@(L["overlay.font.medium"])</button>
                            <button type="button" aria-pressed="@Pressed(_overlayFontScale == 1.25)" @onclick='() => SetOverlayFont(1.25)'>@(L["overlay.font.large"])</button>
                        </div>
                    </div>

                    <p class="rt-note">@(L["overlay.note.fullscreen"])</p>
                </section>

                <section class="rt-rail-sec">
                    <div class="rt-sec-head"><h3>@(L["deck.overlay.obs.title"])</h3></div>
                    <div class="rt-device">
                        <span class="rt-mono">@OverlayUrl</span>
                        <button type="button" class="rt-copy" @onclick="CopyOverlayUrlAsync">@(L["deck.overlay.obs.copy"])</button>
                    </div>
                    <p class="rt-note">@(L["deck.overlay.obs.hint.setup"])</p>
                    <p class="rt-note">@(L["deck.overlay.obs.hint.split"])</p>
                </section>
            </div>
        </aside>
    </div>
</div>

@code {
    private static readonly string[] DefaultDstOptions = ["vi", "en", "ja", "ko", "zh", "ru", "fr", "de", "es"];
    private static readonly CultureInfo ViCulture = CultureInfo.GetCultureInfo("vi");
    private static readonly CultureInfo EnCulture = CultureInfo.GetCultureInfo("en");

    private IReadOnlyList<MonitorInfo> _monitors = Array.Empty<MonitorInfo>();
    private IReadOnlyList<WindowInfo> _windows = Array.Empty<WindowInfo>();
    private string _sourceKind = "screen";      // "screen" | "window"
    private string _monitorId = "0";
    private string _windowHwnd = string.Empty;
    private string _quickDst = "vi";
    private string[] _dstOptions = DefaultDstOptions;
    private string _provider = "google";
    private string _pipelineState = "stopped";  // "stopped" | "running" | "coreError"
    private string? _pipelineError;
    private bool _showOcrNotice;                // first-run: chưa có model OCR nào cài
    private bool _overlayOn;
    private string _overlayMode = "subtitle";   // "subtitle" | "panel"
    private string _overlayCorner = "bl";       // "tl" | "tr" | "bl" | "br"
    private double _overlayFontScale = 1.0;
    private bool _busy;

    private string? _previewSrc;
    private long _lastPreviewRender;
    private int _frameW;
    private int _frameH;
    private double _fps;
    private int _fpsFrames;
    private long _fpsWindowStart;
    private Timer? _fpsTimer;
    private int _boxCount;
    private int _translatedCount;

    /// <summary>Preview refresh cap: ≥100 ms/lần (~10 fps) — data-URL nặng trong WebView không được vẽ mỗi frame. / Preview refresh cap: ≥100 ms per frame (~10 fps).</summary>
    private const long PreviewMinIntervalMs = 100;

    private bool IsRunning => _pipelineState == "running";

    private string SourceDisplay
    {
        get
        {
            if (_sourceKind == "window")
            {
                WindowInfo? match = _windows.FirstOrDefault(w => string.Equals(w.Hwnd, _windowHwnd, StringComparison.OrdinalIgnoreCase));
                return match is null || match.Title.Length == 0 ? L["home.opt.pickWindow"] : match.Title;
            }
            int index = int.TryParse(_monitorId, out int parsed) ? parsed : 0;
            return L.Fmt("deck.source.monitor", index);
        }
    }

    private string FrameSizeText => _frameW > 0 && _frameH > 0 ? $"{_frameW}×{_frameH}" : "—";
    private string FpsText => IsRunning && _fps > 0.05 ? L.Fmt("deck.unit.fps", Num(_fps, 1)) : "—";
    private string BoxText => IsRunning ? L.Fmt("deck.unit.boxes", _boxCount) : "—";
    private string LinesText => IsRunning ? L.Fmt("deck.unit.lines", _translatedCount) : "—";
    private string DirectionText => L.Fmt("deck.chain.direction", Tag(_settingsSrc), Tag(_quickDst));
    private string RunHint => IsRunning
        ? L.Fmt("deck.run.hint.live", SourceDisplay)
        : L["deck.run.hint.idle"];

    // URL overlay OBS — Port là cổng feed thực sự bind (fallback khi 17863 bận).
    private string OverlayUrl => $"http://127.0.0.1:{Feed.Port}/overlay";

    private string ProviderShort => _provider switch
    {
        "google" => "Google",
        "llm" => "LLM",
        _ => _provider,
    };

    private string _settingsSrc = "auto";

    private string Num(double value, int digits) =>
        value.ToString("0." + new string('0', digits), L.Lang == "vi" ? ViCulture : EnCulture);

    private static string Pressed(bool value) => value ? "true" : "false";

    private static string Tag(string code) => code.Trim().ToUpperInvariant() switch
    {
        "AUTO" => "AUTO",
        "VI" => "VI",
        "EN" => "EN",
        "JA" => "JA",
        "KO" => "KO",
        "ZH" => "ZH",
        "RU" => "RU",
        "FR" => "FR",
        "DE" => "DE",
        "ES" => "ES",
        _ => code.Trim().ToUpperInvariant(),
    };

    protected override void OnInitialized()
    {
        L.Changed += OnStateChanged;
        Pipeline.PipelineStateChanged += OnPipelineStateChanged;
        Preview.Changed += OnPreviewChanged;
        Overlay.Changed += OnOverlayChanged;
        SettingsStore.Changed += OnSettingsChanged;

        PreviewFrame? initial = Preview.Latest; // quay lại trang vẫn thấy khung cuối
        _previewSrc = initial is null ? null : PreviewDataUrl(initial);
        if (initial is not null)
        {
            _frameW = initial.W;
            _frameH = initial.H;
        }

        // Quay lại trang này (Home → Settings → Home) phải lấy state thật, không hardcode "stopped".
        _pipelineState = Pipeline.IsRunning ? "running" : "stopped";
        ApplySettings(SettingsStore.Load());
        _overlayOn = OverlaySvc.IsEnabled; // service là nguồn sự thật
        _ = LoadSourcesAsync();
        _ = CheckOcrModelsAsync(); // first-run: báo khi chưa có model OCR nào được cài

        _fpsWindowStart = Environment.TickCount64;
        _fpsTimer = new Timer(_ => TickFps(), null, 1000, 1000);
        base.OnInitialized();
    }

    // Feed overlay OBS start một lần mỗi phiên app (singleton). Vào lại trang thì StartAsync ném
    // "already started" — nuốt như lỗi bind cổng, không được phá trang.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Feed.StartAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            // Đã start từ lần vào trước, hoặc hết cổng loopback — trang vẫn phải sống.
        }
        await base.OnInitializedAsync();
    }

    private void ApplySettings(AppSettings current)
    {
        _quickDst = current.Dst;
        _settingsSrc = current.Src;
        _provider = current.Provider;
        // File ghi tay có thể chứa dst ngoài danh sách — thêm vào để select không bị trống.
        if (Array.IndexOf(_dstOptions, _quickDst) < 0) _dstOptions = [_quickDst, .. DefaultDstOptions];
        _overlayMode = current.OverlayMode;
        _overlayCorner = current.OverlayCorner;
        _overlayFontScale = current.OverlayFontScale;
    }

    // Settings drawer lưu file trên cùng UI thread — Home đọc lại để nhãn provider/ngôn ngữ không cũ.
    private void OnSettingsChanged() => _ = InvokeAsync(async () =>
    {
        ApplySettings(SettingsStore.Load());
        // Notice first-run đang mở → kiểm tra lại: tải model + Lưu model (ghi settings) sẽ tắt nó.
        if (_showOcrNotice) await CheckOcrModelsAsync();
        StateHasChanged();
    });

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    // Nạp danh sách màn hình/cửa sổ từ Core; lỗi → giữ placeholder, không crash UI.
    private async Task LoadSourcesAsync()
    {
        try
        {
            (IReadOnlyList<MonitorInfo> monitors, IReadOnlyList<WindowInfo> windows) =
                await Pipeline.ListSourcesAsync(CancellationToken.None);
            _monitors = monitors;
            _windows = windows;

            // Giữ lựa chọn cũ nếu còn tồn tại; nếu không chọn phần tử đầu tiên.
            if (_monitors.Count > 0 && !_monitors.Any(m => m.Id.ToString() == _monitorId))
            {
                _monitorId = _monitors[0].Id.ToString(CultureInfo.InvariantCulture);
            }
            if (_windows.Count > 0 && !_windows.Any(w => string.Equals(w.Hwnd, _windowHwnd, StringComparison.OrdinalIgnoreCase)))
            {
                _windowHwnd = _windows[0].Hwnd;
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            // Core chưa sẵn sàng → dropdown giữ placeholder, bấm Làm mới thử lại sau.
        }
    }

    private async Task RefreshSourcesAsync()
    {
        await LoadSourcesAsync();
        Toast.Show(L["deck.source.refreshed"]);
    }

    // First-run check: catalog không có model nào installed → hiện notice dẫn tới Cài đặt.
    private async Task CheckOcrModelsAsync()
    {
        try
        {
            IReadOnlyList<OcrModelInfo> models = await Pipeline.ListOcrModelsAsync(CancellationToken.None);
            _showOcrNotice = !models.Any(m => m.Installed);
        }
        catch (Exception)
        {
            // Core chưa sẵn sàng — giữ nguyên trạng thái hiện tại, lần check sau sẽ quyết.
        }
        await InvokeAsync(StateHasChanged);
    }

    private void DismissOcrNotice() => _showOcrNotice = false;

    private void SetSourceKind(string kind)
    {
        _sourceKind = kind;
        if (kind == "window" && string.IsNullOrEmpty(_windowHwnd) && _windows.Count > 0)
        {
            _windowHwnd = _windows[0].Hwnd;
        }
        StateHasChanged();
    }

    private SourceSelection BuildSelection() => _sourceKind == "window"
        ? new SourceSelection(UseWindow: true, Monitor: 0, HwndHex: _windowHwnd)
        : new SourceSelection(
            UseWindow: false,
            Monitor: int.TryParse(_monitorId, out int monitor) ? monitor : 0,
            HwndHex: null);

    private async Task TogglePipelineAsync()
    {
        if (_busy) return;
        if (IsRunning) await StopPipelineAsync();
        else await StartPipelineAsync();
    }

    private async Task StartPipelineAsync()
    {
        if (_sourceKind == "window" && string.IsNullOrEmpty(_windowHwnd))
        {
            _pipelineError = L["deck.error.pickWindow"];
            return;
        }

        _busy = true;
        _pipelineError = null;
        try
        {
            await Pipeline.StartAsync(BuildSelection(), CancellationToken.None);
            _pipelineState = "running";
            _boxCount = 0;
            _translatedCount = 0;
            Interlocked.Exchange(ref _fpsFrames, 0);
            _fpsWindowStart = Environment.TickCount64;
        }
        catch (Exception ex)
        {
            // Cặp model OCR chưa tải — bật notice first-run dẫn tới mục Model OCR trong Cài đặt.
            if (PipelineController.IsOcrModelMissing(ex)) _showOcrNotice = true;
            _pipelineError = L.Fmt("deck.error.start", ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task StopPipelineAsync()
    {
        _busy = true;
        _pipelineError = null;
        try
        {
            await Pipeline.StopAsync(CancellationToken.None);
            _pipelineState = "stopped";
            _fps = 0;
        }
        catch (Exception ex) // core chưa start → ICorePeer.CallAsync ném InvalidOperationException
        {
            _pipelineError = L.Fmt("deck.error.stop", ex.Message);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // PipelineStateChanged nổ trên read-loop thread của peer → marshal về renderer trước khi re-render.
    private void OnPipelineStateChanged(bool running, string? reason) =>
        _ = InvokeAsync(() =>
        {
            if (reason == PipelineController.CoreExitedReason)
            {
                _pipelineState = "stopped";
                _pipelineError = L.Fmt("home.status.coreError", reason);
            }
            else
            {
                _pipelineState = running ? "running" : reason is null ? "stopped" : "coreError";
                if (!running && reason is not null)
                {
                    _pipelineError = L.Fmt("home.status.coreError", reason);
                }
            }
            if (!running) _fps = 0;
            StateHasChanged();
        });

    // frame.annotated đến từ read-loop thread của peer; đếm fps trước, throttle preview ≥100 ms.
    private void OnPreviewChanged(PreviewFrame frame) => _ = InvokeAsync(() =>
    {
        Interlocked.Increment(ref _fpsFrames);
        _frameW = frame.W;
        _frameH = frame.H;

        long now = Environment.TickCount64;
        if (now - _lastPreviewRender < PreviewMinIntervalMs) return;
        _lastPreviewRender = now;
        _previewSrc = PreviewDataUrl(frame);
        StateHasChanged();
    });

    // frame.translated ~3 fps — đủ rẻ để đọc box/dòng dịch cho rail.
    private void OnOverlayChanged() => _ = InvokeAsync(() =>
    {
        OverlayFrame? frame = Overlay.Latest;
        _boxCount = frame?.Boxes.Count ?? 0;
        _translatedCount = frame?.Boxes.Count(b => !string.IsNullOrWhiteSpace(b.Translated)) ?? 0;
        StateHasChanged();
    });

    // Timer 1 s: fps = số frame nhận được trong cửa sổ vừa qua; dừng pipeline thì về 0.
    private void TickFps()
    {
        long now = Environment.TickCount64;
        int frames = Interlocked.Exchange(ref _fpsFrames, 0);
        double elapsed = Math.Max(0.001, (now - _fpsWindowStart) / 1000.0);
        _fpsWindowStart = now;
        double fps = frames / elapsed;

        bool running = IsRunning;
        bool changed = Math.Abs(fps - _fps) >= 0.05 || (running && fps == 0 && _fps > 0);
        _fps = fps;
        if (running && changed) _ = InvokeAsync(StateHasChanged);
    }

    private static string PreviewDataUrl(PreviewFrame frame) =>
        $"data:image/jpeg;base64,{frame.JpegBase64}";

    // Ghi ngay dst mới vào settings.json — áp dụng cho lần start kế tiếp.
    private void SaveQuickDst()
    {
        try
        {
            SettingsStore.Save(SettingsStore.Load() with { Dst = _quickDst });
        }
        catch (Exception)
        {
            // Ghi file fail không được phá UI — dst giữ trong RAM cho lần start sau.
        }
    }

    // Service tự persist OverlayOnGame; UI chỉ mirror IsEnabled.
    private void ToggleOverlay()
    {
        _overlayOn = !_overlayOn;
        OverlaySvc.SetEnabled(_overlayOn);
    }

    private void ApplyOverlayMode() => OverlaySvc.ApplyOptions(mode: _overlayMode);

    private void ApplyOverlayCorner() => OverlaySvc.ApplyOptions(corner: _overlayCorner);

    private async Task SetOverlayFont(double scale)
    {
        _overlayFontScale = scale;
        OverlaySvc.ApplyOptions(fontScale: scale);
        try
        {
            // Core renders the preview/camera frame; tell it the new size right away.
            // Core vẽ khung preview/camera; báo cỡ mới ngay để không phải chờ phiên sau.
            await Pipeline.SetAnnotationFontScaleAsync(scale, CancellationToken.None);
        }
        catch (Exception)
        {
            // Core cũ/không sẵn sàng không được phá UI; overlay vẫn đổi cỡ chữ.
            // An old/unavailable Core must not break the UI; the overlay still resizes.
        }
    }

    private async Task CopyOverlayUrlAsync()
    {
        try
        {
            await Js.CopyTextAsync(OverlayUrl);
            Toast.Show(L["deck.overlay.obs.copied"]);
        }
        catch (Exception)
        {
            // Clipboard bị chặn không được phá UI.
        }
    }

    public void Dispose()
    {
        L.Changed -= OnStateChanged;
        Pipeline.PipelineStateChanged -= OnPipelineStateChanged;
        Preview.Changed -= OnPreviewChanged;
        Overlay.Changed -= OnOverlayChanged;
        SettingsStore.Changed -= OnSettingsChanged;
        _fpsTimer?.Dispose();
        _fpsTimer = null;
    }
}
