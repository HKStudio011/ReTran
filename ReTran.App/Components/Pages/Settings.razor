@page "/settings"
@using ReTran_App.Services
@inject I18nService L
@implements IDisposable

<PageTitle>@(L["settings.title"])</PageTitle>

<div class="rt-page">
    <div class="rt-page-head">
        <h1>@(L["settings.title"])</h1>
    </div>
    <div class="rt-panel">
        <SettingsPanel />
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        L.Changed += OnStateChanged;
        base.OnInitialized();
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnStateChanged;
}
