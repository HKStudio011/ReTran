@* ErrorBoundary có log: Blazor Hybrid KHÔNG đưa exception render qua ILogger (banner
   "An unhandled error has occurred" là triệu chứng duy nhất user thấy) — override OnErrorAsync
   để stack đổ vào file log (%LOCALAPPDATA%\ReTran\logs) trước khi fallback hiển thị.
   Fallback tự chứa (danger text + Thử lại = Recover) vì ErrorBoundary gốc không map được
   <ErrorContent> trong razor usage của SetupModal.
   ErrorBoundary with logging: Blazor Hybrid does not route render exceptions through ILogger
   (the generic "An unhandled error has occurred" banner is the only symptom the user sees) —
   OnErrorAsync dumps the stack into the file log before the fallback shows. The fallback is
   self-contained (danger text + Retry = Recover) because the base ErrorContent tag does not
   map in SetupModal's razor usage. *@
@inherits ErrorBoundary
@using Microsoft.Extensions.Logging
@using ReTran_App.Services
@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="fixed inset-0 flex items-center justify-center bg-black/50 p-4" style="z-index: 60;">
        <div role="alert" class="rt-setup-modal w-full max-w-sm rounded-lg border border-surface bg-background p-4 shadow-xl">
            <p class="mb-3 text-sm" style="color: var(--rt-danger);">@L["setup.renderError"]</p>
            <button type="button" class="rt-btn rt-mini" @onclick="Recover">@L["setup.error.retry"]</button>
        </div>
    </div>
}
@code {
    [Inject]
    private ILogger<LoggingErrorBoundary> Logger { get; set; } = null!;

    [Inject]
    private I18nService L { get; set; } = null!;

    /// <inheritdoc/>
    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "setup-modal: unhandled rendering exception (ErrorBoundary caught)");
        return Task.CompletedTask;
    }
}
