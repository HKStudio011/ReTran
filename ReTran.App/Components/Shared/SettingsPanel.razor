    private void OnLlmFlavorChanged(ChangeEventArgs args)
    {
        if (_llmRuntimeBusy) return;
        string selected = args.Value?.ToString() == "cpu" ? "cpu" : "cuda";
        if (selected == _llmFlavor) return;
        _llmFlavor = selected;
        _llmRuntimeRevision++;
        _llmRuntimeCheck = null; // kết quả check thuộc flavor cũ
        _llmRuntime = null;
        _ = LoadLlmRuntimeAsync();
    }

    private async Task CheckLlmRuntimeAsync()
    {
        if (_llmRuntimeBusy) return;
        _llmRuntimeBusy = true;
        string requestedFlavor = _llmFlavor;
        int requestedRevision = _llmRuntimeRevision;
        try
        {
            LlmRuntimeCheckInfo check = await Pipeline.CheckLlmRuntimeAsync(
                requestedFlavor, CancellationToken.None);
            if (!IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
            _llmRuntimeCheck = check;
            await LoadLlmRuntimeAsync();
            if (!IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
            if (check.Latest is not { } latest)
            {
                Toast.Show(L["deck.llm.runtime.noAsset"]);
            }
            else if (string.Equals(latest, check.Current, StringComparison.Ordinal))
            {
                Toast.Show(L.Fmt("deck.llm.runtime.latest", latest));
            }
            else
            {
                Toast.Show(L.Fmt("deck.llm.runtime.checkFound", latest));
            }
        }
        catch (Exception ex)
        {
            if (IsCurrentLlmFlavor(requestedFlavor, requestedRevision))
                Toast.Show(L.Fmt("deck.llm.runtime.checkFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _llmRuntimeBusy = false;
            RequestRender();
        }
    }

    // Tải runtime (đặt mới/cập nhật/sửa cùng tag) rồi poll trạng thái thật của lượt tải.
    private async Task DownloadLlmRuntimeAsync()
    {
        if (_llmRuntimeBusy) return;
        _llmRuntimeBusy = true;
        string requestedFlavor = _llmFlavor;
        int requestedRevision = _llmRuntimeRevision;
        try
        {
            long downloadAttempt = await Pipeline.DownloadLlmRuntimeAsync(requestedFlavor, CancellationToken.None);
            if (!IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
            Toast.Show(L.Fmt("deck.llm.runtime.downloadStarted", L["deck.llm.runtime.flavor." + requestedFlavor]));
            for (int i = 0; i < LlmRuntimePollAttempts; i++)
            {
                await Task.Delay(LlmRuntimePollInterval);
                if (_disposed || !IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
                LlmRuntimeStatusInfo status = await Pipeline.GetLlmRuntimeStatusAsync(
                    CancellationToken.None, requestedFlavor);
                if (!IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
                _llmRuntime = status;
                RequestRender();
                switch (LlmRuntimePoll.Evaluate(status, downloadAttempt))
                {
                    case LlmRuntimePollOutcome.Superseded:
                        Toast.Show(L["deck.llm.runtime.downloadSuperseded"], ToastSeverity.Error);
                        return;
                    case LlmRuntimePollOutcome.Cancelled:
                        // Hủy chủ động không phải success và cũng không cần error toast.
                        return;
                    case LlmRuntimePollOutcome.Failed:
                        Toast.Show(status.DownloadError is { } error
                            ? L.Fmt("deck.llm.runtime.downloadFailedDetail", error)
                            : L["deck.llm.runtime.downloadFailed"], ToastSeverity.Error);
                        return;
                    case LlmRuntimePollOutcome.Completed:
                        // Check lại theo đúng flavor sau MỌI lượt thành công: repair cùng tag không
                        // làm badge Update bị xoá nhầm, flavor mới không bị so với release CUDA.
                        LlmRuntimeCheckInfo check = await Pipeline.CheckLlmRuntimeAsync(
                            requestedFlavor, CancellationToken.None);
                        if (!IsCurrentLlmFlavor(requestedFlavor, requestedRevision)) return;
                        _llmRuntimeCheck = check;
                        Toast.Show(L["deck.llm.runtime.installedToast"]);
                        return;
                }
            }
            if (IsCurrentLlmFlavor(requestedFlavor, requestedRevision))
                Toast.Show(L["deck.llm.runtime.downloadTimeout"], ToastSeverity.Error);
        }
        catch (Exception ex)
        {
            if (IsCurrentLlmFlavor(requestedFlavor, requestedRevision))
                Toast.Show(L.Fmt("deck.llm.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _llmRuntimeBusy = false;
            RequestRender();
        }
    }

