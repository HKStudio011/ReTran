@* Setup rerun vẫn hỏi lại từ bước 1 và chỉ tải artifact thiếu/hỏng; System ẩn hoàn toàn
   khi cả setup lẫn update đều không có hành động khả dụng. *@
@if (!Setup.IsRunning || UpdateFeature.IsEnabled)
{
    <section class="rt-sect">
        <h3>@(L["deck.settings.section.system"])</h3>
        @if (!Setup.IsRunning)
        {
            <div class="rt-settings-group">
                <h4 class="rt-group-title">@(L["deck.settings.group.setup"])</h4>
                <div class="rt-field-row" style="flex-wrap: wrap; gap: 10px;">
                    <button type="button" class="rt-btn rt-mini" disabled="@_rerunStarted" @onclick="RerunSetup">@(L["setup.rerun"])</button>
                </div>
            </div>
        }
        @if (UpdateFeature.IsEnabled)
        {
            <div class="rt-settings-group">
                <h4 class="rt-group-title">@(L["deck.settings.section.update"])</h4>
                <div class="rt-field-row" style="flex-wrap: wrap; gap: 10px;">
                    <span class="rt-hint rt-mono">v@_appVersion</span>
                    @if (Check.IsUpdateAvailable)
                    {
                        <span class="rt-chip live"><span class="rt-lamp"></span><span class="rt-txt">@(L["update.badge"])</span></span>
                    }
                    <button type="button" class="rt-btn rt-mini" disabled="@_checking" @onclick="CheckAsync">@(L["update.check"])</button>
                    @if (Check.IsUpdateAvailable)
                    {
                        <button type="button" class="rt-btn rt-btn-primary rt-mini" disabled="@Coordinator.UpdateInProgress" @onclick="UpdateNow">@(L["update.now"])</button>
                    }
                </div>
            </div>
        }
    </section>
}

@code {
    // Model mutable cho @bind — AppSettings là record init-only nên không bind trực tiếp được.
    private sealed class SettingsModel
    {
        public string Provider { get; set; } = "google";
        public string Src { get; set; } = "auto";
        public string Dst { get; set; } = "vi";
    }

    private static readonly string[] SrcCodes = ["auto", "en", "ja", "ko", "zh", "ru", "fr", "de", "es"];
    private static readonly string[] DstCodes = ["vi", "en", "ja", "ko", "zh", "ru", "fr", "de", "es"];

    private readonly SettingsModel _model = new();
    private string[] _srcOptions = SrcCodes;
    private string[] _dstOptions = DstCodes;
    private string? _statusKind; // "saved" | "saveFailed" | null
    private string _appVersion = string.Empty;
    private bool _checking;
    private string _themeSetting = "system";
    private bool _appearanceLoaded;

    // OCR model manager: null = chưa nạp catalog; _ocrBusy chặn bấm chồng khi RPC đang chạy.
    private static readonly TimeSpan OcrDownloadPollInterval = TimeSpan.FromSeconds(2);
    private const int OcrDownloadPollAttempts = 300;
    private IReadOnlyList<OcrModelInfo>? _ocrModels;
    private bool _ocrLoadFailed;
    private bool _ocrBusy;
    private string _ocrDetPick = "PP-OCRv6_small_det";
    private string _ocrRecPick = "PP-OCRv6_small_rec";
    // Baseline của lần gán programmatic gần nhất — phân biệt edit chưa lưu với giá trị wizard ghi.
    private string _ocrDetBaseline = "PP-OCRv6_small_det";
    private string _ocrRecBaseline = "PP-OCRv6_small_rec";

    // Tham số máy OCR: schema nạp từ Core (null = đang tải hoặc lỗi); control text/bool theo key.
    private IReadOnlyList<OcrParamSpec>? _ocrSchema;
    private bool _ocrSchemaFailed;
    private bool _ocrParamsBusy;
    private readonly Dictionary<string, string> _ocrText = new();
    private readonly Dictionary<string, bool> _ocrBool = new();
    private readonly Dictionary<string, string> _ocrFieldErrors = new();
    // Key user đã đặt trong settings.json — nguồn cho control; {} = mọi giá trị về mặc định (C5).
    private Dictionary<string, JsonNode?> _ocrValues = new();
    private string _ocrFpsText = "3";
    private string _captureFpsText = "10";
    private bool _mergeLines = true; // Gộp nhiều dòng thành một khối trước khi dịch (áp dụng từ lần Start kế tiếp).
    // Ngưỡng gộp dòng ở dạng text thô cho ô nhập — parse+range check lúc Lưu (OcrMergeThresholds).
    private string _mergeGapText = "0.6";
    private string _mergeHeightText = "1.35";
    private string _mergeOverlapText = "0.5";
    private string _ocrStatusText = string.Empty;
    private bool _ocrStatusError;

    // LLM provider (plan 2026-11-14): mode + field API/local; prompt hiển thị mặc định Hy-MT2 khi
    // chưa ghi đè (null trong settings.json) — Lưu so lại với mặc định để giữ ngữ nghĩa "null = mặc định".
    private string _llmMode = "local";
    private string _llmBaseUrl = "";
    private string _llmApiKey = "";
    private string _llmApiModel = "Hy-MT2-1.8B";
    private string _llmActiveModel = "Hy-MT2-1.8B-UD-Q4_K_XL";
    private string _llmActiveModelBaseline = "Hy-MT2-1.8B-UD-Q4_K_XL";
    private string _llmSystemPromptText = LlmPromptDefaults.SystemPrompt;
    private string _llmUserPromptText = LlmPromptDefaults.UserPrompt;
    private string _llmFlavor = "cuda";
    private IReadOnlyList<LlmModelInfo>? _llmModels;
    private bool _llmModelsFailed;
    private bool _llmModelsBusy;
    private LlmRuntimeStatusInfo? _llmRuntime;
    private LlmRuntimeCheckInfo? _llmRuntimeCheck;
    private bool _llmRuntimeBusy;
    private int _llmRuntimeRevision;
    private LlmServerStatusInfo? _llmServerStatus;
    private bool _llmServerStatusFailed;
    private bool _llmServerStatusBusy;
    private bool _wasSetupComplete;
    private bool _setupResyncBusy;
    private bool _disposed;

    private string StatusText => _statusKind switch
    {
        "saved" => L["settings.status.saved"],
        "saveFailed" => L["settings.status.saveFailed"],
        "llmPromptInvalid" => L["deck.llm.prompt.invalid"],
        _ => string.Empty,
    };

    private static string Pressed(bool value) => value ? "true" : "false";

    // Mọi callback/poll đi qua gate này: unsubscribe không đủ vì một await có thể hoàn tất sau Dispose.
    private void RequestRender()
    {
        if (SettingsPanelSync.ShouldRender(_disposed)) StateHasChanged();
    }

    private Task RequestRenderAsync() =>
        SettingsPanelSync.ShouldRender(_disposed) ? InvokeAsync(StateHasChanged) : Task.CompletedTask;

    protected override void OnInitialized()
    {
        AppSettings current = SettingsStore.Load();
        _model.Provider = SettingsPanelSync.NormalizeProvider(current.Provider);
        _model.Src = current.Src;
        _model.Dst = current.Dst;
        _ocrDetPick = current.OcrDet;
        _ocrRecPick = current.OcrRec;
        _ocrDetBaseline = current.OcrDet;
        _ocrRecBaseline = current.OcrRec;
        _mergeLines = current.OcrMergeLines;
        _mergeGapText = FormatThreshold(current.OcrMergeGap);
        _mergeHeightText = FormatThreshold(current.OcrMergeHeight);
        _mergeOverlapText = FormatThreshold(current.OcrMergeOverlap);
        _llmMode = current.LlmMode;
        _llmBaseUrl = current.LlmBaseUrl;
        _llmApiKey = current.LlmApiKey ?? string.Empty;
        _llmApiModel = current.LlmApiModel;
        _llmActiveModel = current.LlmActiveModel;
        _llmActiveModelBaseline = current.LlmActiveModel;
        _llmSystemPromptText = current.LlmSystemPrompt ?? LlmPromptDefaults.SystemPrompt;
        _llmUserPromptText = current.LlmUserPrompt ?? LlmPromptDefaults.UserPrompt;
        _appVersion = AppVersionFormatter.Format(Updates.CurrentVersion);
        // File ghi tay có thể chứa giá trị ngoài danh sách — thêm vào để select không bị trống.
        if (Array.IndexOf(_srcOptions, current.Src) < 0) _srcOptions = [current.Src, .. _srcOptions];
        if (Array.IndexOf(_dstOptions, current.Dst) < 0) _dstOptions = [current.Dst, .. _dstOptions];
        L.Changed += OnStateChanged;
        Js.OnWebViewReady += OnStateChanged;
        Setup.Changed += OnSetupChanged; // theo dõi wizard để hiện/ẩn section + resync sau completion
        Pipeline.StateChanged += OnPipelineChanged;
        _wasSetupComplete = Setup.IsComplete;
        _ = LoadOcrModelsAsync(syncFromActive: true); // lần đầu: hiển thị cặp sidecar đang dùng thật
        _ = LoadOcrSchemaAsync(); // nạp schema tham số engine từ Core (fire-and-forget)
        _ = LoadLlmModelsAsync(); // nạp catalog GGUF từ Core (fire-and-forget)
        _ = LoadLlmRuntimeAsync(); // nạp trạng thái runtime llama.cpp từ Core (fire-and-forget)
        _ = LoadLlmServerStatusAsync(); // trạng thái server local lazy (loading/ready/error/stopped)
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = LoadAppearanceAsync();
        base.OnAfterRender(firstRender);
    }

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAppearanceAsync();
        RequestRender();
    });

    private void OnPipelineChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        await LoadLlmServerStatusAsync();
        if (!_disposed) RequestRender();
    });

    // Theme sống trong localStorage của WebView — đọc lại sau khi JS bridge sẵn sàng.
    private async Task LoadAppearanceAsync()
    {
        if (_appearanceLoaded || !Js.IsWebViewReady) return;
        try
        {
            string? theme = await Js.GetThemeSettingAsync();
            if (theme is "light" or "dark" or "system") _themeSetting = theme;
            _appearanceLoaded = true;
        }
        catch (Exception)
        {
            // JS chưa sẵn sàng — giữ mặc định, lần mở sheet sau đọc lại.
        }
    }

    private void Save()
    {
        _model.Provider = SettingsPanelSync.NormalizeProvider(_model.Provider);
        // Prompt LLM: ô trắng hoặc thiếu {source_text} đều lỗi ngay tại Settings — không để Core
        // âm thầm đổi hành vi user vừa nhập thành prompt mặc định ở lần Start kế tiếp (spec D1).
        if (!SettingsPanelSync.LlmUserPromptValid(_model.Provider, _llmUserPromptText))
        {
            _statusKind = "llmPromptInvalid";
            return;
        }
        try
        {
            // `with` giữ nguyên overlay/capture options hiện có — form này sửa provider/ngôn ngữ/LLM.
            SettingsStore.Update(current => current with
            {
                Provider = _model.Provider,
                Src = _model.Src,
                Dst = _model.Dst,
                LlmMode = _llmMode,
                LlmBaseUrl = _llmBaseUrl,
                LlmApiKey = string.IsNullOrWhiteSpace(_llmApiKey) ? null : _llmApiKey,
                LlmApiModel = _llmApiModel,
                LlmActiveModel = _llmActiveModel,
                LlmSystemPrompt = NormalizeLlmPrompt(_llmSystemPromptText, LlmPromptDefaults.SystemPrompt),
                LlmUserPrompt = NormalizeLlmPrompt(_llmUserPromptText, LlmPromptDefaults.UserPrompt),
            });
            _llmActiveModelBaseline = _llmActiveModel;
            _statusKind = "saved";
            Toast.Show(L["settings.status.saved"]);
        }
        catch (Exception)
        {
            _statusKind = "saveFailed";
        }
    }

    // Trùng mặc định (hoặc rỗng/toàn khoảng trắng = Core coi như không ghi đè) → lưu null để giữ
    // ngữ nghĩa "null = theo mặc định Hy-MT2", không ghim bản sao mặc định vào settings.json (D11).
    private static string? NormalizeLlmPrompt(string text, string defaultValue) =>
        text == defaultValue || string.IsNullOrWhiteSpace(text) ? null : text;

    // Cặp det/rec đang dùng của sidecar — hai model có cờ InUse trong catalog.
    private string OcrActivePairText
    {
        get
        {
            if (_ocrModels is null) return string.Empty;
            OcrModelInfo? det = _ocrModels.FirstOrDefault(m => m.Kind == "det" && m.InUse);
            OcrModelInfo? rec = _ocrModels.FirstOrDefault(m => m.Kind == "rec" && m.InUse);
            return det is null || rec is null ? string.Empty : L.Fmt("deck.ocr.activePair", det.Name, rec.Name);
        }
    }

    private string OcrMetaText(OcrModelInfo m) =>
        $"{m.Kind} · {L.Fmt("deck.ocr.langsCount", m.Langs.Count)} · {CompactLangs(m)} · {m.SizeMb:0.#} MB";

    private string OcrProgressText(OcrModelInfo m)
    {
        if (m.Progress is not { } progress) return L["deck.ocr.downloading"];
        (int? percent, TimeSpan? eta) = ReTran_App.Services.Setup.DownloadProgressText.Format(
            progress.ReceivedBytes, progress.TotalBytes, progress.BytesPerSec);
        if (percent is not int value) return L["deck.ocr.downloading"];
        string text = L.Fmt("deck.ocr.progress", value);
        if (eta is { } remaining) text += " · " + L.Fmt("setup.progress.eta", FormatEta(remaining));
        else if (progress.BytesPerSec is null or <= 0) text += " · " + L["setup.progress.retry"];
        return text;
    }

    private string FormatEta(TimeSpan eta) =>
        eta.TotalMinutes < 1
            ? L.Fmt("setup.progress.seconds", Math.Max(1, Math.Ceiling(eta.TotalSeconds)).ToString("0"))
            : L.Fmt("setup.progress.minutes", Math.Ceiling(eta.TotalMinutes).ToString("0"));

    // Nhóm bảng model OCR (spec 17-11 §11): họ OCR v6 trước, rồi rec legacy (nhóm "Ngôn ngữ"),
    // phần còn lại (det ngoài họ v6…) vào "Khác". Thứ tự catalog giữ nguyên trong từng nhóm.
    private IEnumerable<(string GroupKey, List<OcrModelInfo> Models)> OcrTableGroups()
    {
        List<OcrModelInfo> all = _ocrModels?.ToList() ?? [];
        var v6 = all.Where(m => m.Name.StartsWith("PP-OCRv6", StringComparison.Ordinal)).ToList();
        var langs = all.Where(m => m.Kind == "rec" && !m.Name.StartsWith("PP-OCRv6", StringComparison.Ordinal)).ToList();
        var other = all.Where(m => !m.Name.StartsWith("PP-OCRv6", StringComparison.Ordinal) && m.Kind != "rec").ToList();
        if (v6.Count > 0) yield return ("deck.ocr.group.v6", v6);
        if (langs.Count > 0) yield return ("deck.ocr.group.langs", langs);
        if (other.Count > 0) yield return ("deck.ocr.group.other", other);
    }

    // Danh sách ngôn ngữ nén để vừa một dòng hint: tối đa 6 mã, phần còn lại gộp "+N".
    private static string CompactLangs(OcrModelInfo m)
    {
        string head = string.Join(", ", m.Langs.Take(6));
        return m.Langs.Count > 6 ? $"{head} +{m.Langs.Count - 6}" : head;
    }

    // Spec §6.1: cảnh báo khi ngôn ngữ nguồn (khác auto) không nằm trong phạm vi model rec
    // đang dùng của sidecar (ví dụ src "ko" trên cặp v6) — trả mã ngôn ngữ để format chuỗi,
    // null khi không có gì để cảnh báo.
    private string? OcrSrcNotCovered
    {
        get
        {
            if (_ocrModels is null) return null;
            OcrModelInfo? activeRec = _ocrModels.FirstOrDefault(m => m.Kind == "rec" && m.InUse);
            return activeRec is not null && !OcrModelCoverage.Covers(activeRec, _model.Src)
                ? _model.Src
                : null;
        }
    }

    // Nạp catalog model từ Core; lỗi → giữ placeholder, Làm mới thử lại. Chỉ lần đầu/apply-ngay/
    // resync chủ động mới lấy InUse ghi đè pick; reload thường giữ lựa chọn deferred của user (C8).
    private async Task LoadOcrModelsAsync(bool syncFromActive = false)
    {
        try
        {
            IReadOnlyList<OcrModelInfo> models = await Pipeline.ListOcrModelsAsync(CancellationToken.None);
            _ocrModels = models;
            _ocrLoadFailed = false;
            (_ocrDetPick, _ocrRecPick) = SettingsPanelSync.OcrPicks(
                models, _ocrDetPick, _ocrRecPick, syncFromActive);
            if (syncFromActive)
            {
                _ocrDetBaseline = _ocrDetPick;
                _ocrRecBaseline = _ocrRecPick;
            }
        }
        catch (Exception)
        {
            // Core chưa sẵn sàng — giữ danh sách cũ/placeholder, bấm Làm mới thử lại.
            _ocrLoadFailed = true;
        }
        await RequestRenderAsync();
    }

    private async Task ReloadOcrModelsAsync()
    {
        if (_ocrBusy) return;
        _ocrBusy = true;
        try
        {
            await LoadOcrModelsAsync();
        }
        finally
        {
            _ocrBusy = false;
            RequestRender();
        }
    }

    private async Task DownloadOcrModelAsync(OcrModelInfo model)
    {
        if (_ocrBusy) return;
        _ocrBusy = true;
        try
        {
            await Pipeline.DownloadOcrModelAsync(model.Name, CancellationToken.None);
            Toast.Show(L.Fmt("deck.ocr.downloadStarted", model.Name));
            for (int i = 0; i < OcrDownloadPollAttempts; i++)
            {
                await LoadOcrModelsAsync();
                OcrModelInfo? current = _ocrModels?.FirstOrDefault(m => m.Name == model.Name);
                if (current?.Installed == true)
                {
                    Toast.Show(L.Fmt("deck.ocr.downloaded", model.Name));
                    return;
                }
                if (current?.Downloading == false)
                {
                    string error = current.DownloadError ?? L["deck.ocr.downloadEnded"];
                    Toast.Show(L.Fmt("deck.ocr.actionFailed", error), ToastSeverity.Error);
                    return;
                }
                await Task.Delay(OcrDownloadPollInterval);
                if (_disposed) return;
            }
            Toast.Show(L["deck.ocr.downloadTimeout"], ToastSeverity.Error);
        }
        catch (Exception ex)
        {
            Toast.Show(L.Fmt("deck.ocr.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _ocrBusy = false;
            RequestRender();
        }
    }

    private async Task DeleteOcrModelAsync(OcrModelInfo model)
    {
        if (_ocrBusy) return;
        _ocrBusy = true;
        try
        {
            string[] installed = (_ocrModels ?? [])
                .Where(candidate => candidate.Installed && candidate.Name != model.Name)
                .Select(candidate => candidate.Name)
                .ToArray();
            string[] engineActive = (_ocrModels ?? [])
                .Where(candidate => candidate.InUse && candidate.Name != model.Name)
                .Select(candidate => candidate.Name)
                .ToArray();
            Setup.BeginModelDeletion(model.Name, installed, engineActive);
            await Pipeline.DeleteOcrModelAsync(model.Name, CancellationToken.None);
            Setup.RemoveDeletedModel(model.Name, installed, engineActive);
            AppSettings synchronized = SettingsStore.Load();
            _ocrDetPick = synchronized.OcrDet;
            _ocrRecPick = synchronized.OcrRec;
            _ocrDetBaseline = synchronized.OcrDet;
            _ocrRecBaseline = synchronized.OcrRec;
            Toast.Show(L.Fmt("deck.ocr.deleted", model.Name));
            await LoadOcrModelsAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(L.Fmt("deck.ocr.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _ocrBusy = false;
            RequestRender();
        }
    }

    private async Task SaveOcrPairAsync()
    {
        if (_ocrBusy) return;
        _ocrBusy = true;
        try
        {
            // Cặp đã chọn phải vào settings.json trước tiên — core.start lần sau gửi đúng cặp
            // này kể cả khi bên dưới bị hoãn (đang chạy thì không đổi model giữa phiên, C8).
            SettingsStore.Update(current => current with { OcrDet = _ocrDetPick, OcrRec = _ocrRecPick });
            _ocrDetBaseline = _ocrDetPick;
            _ocrRecBaseline = _ocrRecPick;
            // C8: pipeline đang chạy → không gọi ocr.models.set (sidecar giữ predictor đang
            // nạp; đổi giữa phiên tốn nạp lại cả model, đo được tới 27,1 s) — cặp mới áp dụng
            // ở lần start kế tiếp.
            bool appliedNow = await Pipeline.ApplyOcrPairIfIdleAsync(_ocrDetPick, _ocrRecPick, CancellationToken.None);
            Toast.Show(appliedNow ? L["deck.ocr.pairSaved"] : L["deck.ocr.pairDeferred"]);
            await LoadOcrModelsAsync(syncFromActive: appliedNow);
        }
        catch (Exception ex)
        {
            Toast.Show(L.Fmt("deck.ocr.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _ocrBusy = false;
            RequestRender();
        }
    }

    // Nạp schema tham số engine từ Core; lỗi → thông báo + nút Làm mới, không làm chết trang.
    private async Task LoadOcrSchemaAsync()
    {
        try
        {
            IReadOnlyList<OcrParamSpec> schema = await Pipeline.GetOcrConfigSchemaAsync(CancellationToken.None);
            _ocrSchema = schema;
            _ocrSchemaFailed = false;
            ApplySettingsToOcrState();
        }
        catch (Exception)
        {
            // Core/sidecar chưa sẵn sàng — giữ schema cũ (nếu có), bấm Làm mới thử lại.
            _ocrSchemaFailed = true;
        }
        await RequestRenderAsync();
    }

