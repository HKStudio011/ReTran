    private async Task SetLangAsync(string lang)
    {
        if (lang == L.Lang) return;
        L.Set(lang);
        try
        {
            await Js.SetLangAsync(lang);
        }
        catch (Exception)
        {
            // Lưu thất bại không ảnh hưởng ngôn ngữ đã áp trong RAM.
        }
    }

    private async Task CheckAsync()
    {
        if (_checking) return;
        _checking = true;
        try
        {
            // Bắt trạng thái TRƯỚC khi check: chuyển tiếp none→available sẽ bắn UpdateFound
            // (MainLayout đã toast) — chỉ toast khi user check lại update đã biết.
            var wasAvailable = Check.IsUpdateAvailable;
            var result = await Check.CheckOnceAsync();
            if (result == UpdateCheckResult.UpdateAvailable && wasAvailable
                && Check.AvailableRelease is { } release)
            {
                Toast.Show(string.Format(L["update.available"], release.TagName));
            }
            else if (result == UpdateCheckResult.AlreadyLatest)
            {
                Toast.Show(L["update.latest"]);
            }
            else if (result == UpdateCheckResult.Failed)
            {
                Toast.Show(L["update.checkFailed"], ToastSeverity.Error);
            }
        }
        finally
        {
            _checking = false;
        }
    }

    private void UpdateNow()
    {
        if (Check.AvailableRelease is not { } release) return;
        if (Coordinator.UpdateInProgress) return;
        _ = Coordinator.StartUpdateAsync(release);
    }

    // "Chạy lại setup": force wizard — bước đã done được skip, mọi thứ sẵn sàng thì đi qua trong vài giây.
    private bool _rerunStarted;

    private void RerunSetup()
    {
        if (_rerunStarted) return;
        _rerunStarted = true;
        // Bước Checking làm WMI + probe mạng đồng bộ — chạy ngoài UI thread như đường first-run của SetupModal.
        _ = Task.Run(() => Setup.StartAsync(force: true));
    }

    // Wizard publish từ luồng nền (pattern UpdateModal) — marshal về UI thread: khi wizard xong lại thì
    // bật nút rerun trở lại và re-render để section "Cài đặt" hiện/ẩn theo đúng IsComplete.
    private void OnSetupChanged() => _ = InvokeAsync(() =>
    {
        if (Setup.IsComplete) _rerunStarted = false;
        StateHasChanged();
    });

    public void Dispose()
    {
        L.Changed -= OnStateChanged;
        Js.OnWebViewReady -= OnStateChanged;
        Setup.Changed -= OnSetupChanged;
    }
}
