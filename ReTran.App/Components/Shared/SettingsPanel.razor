    private async Task CheckAsync()
    {
        if (_checking) return;
        _checking = true;
        try
        {
            // Bắt trạng thái TRƯỚC khi check: chuyển tiếp none→available sẽ bắn UpdateFound
            // (MainLayout đã toast) — chỉ toast khi user check lại update đã biết.
            var wasAvailable = Check.IsUpdateAvailable;
            var result = await Check.CheckOnceAsync();
            if (result == UpdateCheckResult.UpdateAvailable && wasAvailable
                && Check.AvailableRelease is { } release)
            {
                Toast.Show(string.Format(L["update.available"], release.TagName));
            }
            else if (result == UpdateCheckResult.AlreadyLatest)
            {
                Toast.Show(L["update.latest"]);
            }
            else if (result == UpdateCheckResult.Failed)
            {
                Toast.Show(L["update.checkFailed"], ToastSeverity.Error);
            }
        }
        finally
        {
            _checking = false;
        }
    }

    private void UpdateNow()
    {
        if (Check.AvailableRelease is not { } release) return;
        if (Coordinator.UpdateInProgress) return;
        _ = Coordinator.StartUpdateAsync(release);
    }

    // "Chạy lại setup": force wizard = SỬA LỖI chạy lại từ bước 1 (xoá answers + marker, hỏi lại cả
    // 3 màn, pipeline xác minh lại; model đã cài thật vẫn không tải lại — spec BA 17-11).
    private bool _rerunStarted;

    private void RerunSetup()
    {
        if (_rerunStarted) return;
        _rerunStarted = true;
        // Bước Checking làm WMI + probe mạng đồng bộ — chạy ngoài UI thread như đường first-run của SetupModal.
        _ = Task.Run(() => Setup.StartAsync(force: true));
    }

    // Wizard publish từ luồng nền (pattern UpdateModal) — marshal về UI thread: khi lượt rerun kết thúc
    // thì bật nút rerun trở lại và re-render để section "Cài đặt" hiện/ẩn theo đúng trạng thái.
    // Reset theo !IsRunning (không chỉ IsComplete): lượt rerun kết thúc ở Failed vẫn phải để nút bấm lại
    // được — vòng lặp rerun→fail→"Bỏ qua thiết lập"→rerun (spec 2026-11-13); publish cuối lúc fail có
    // thể vẫn IsRunning, lần publish kế tiếp khi đã rảnh mới reset được.
    private void OnSetupChanged() => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        bool isComplete = Setup.IsComplete;
        bool resync = SettingsPanelSync.WizardCompletionTransition(_wasSetupComplete, isComplete);
        _wasSetupComplete = isComplete;
        if (isComplete || !Setup.IsRunning) _rerunStarted = false;
        if (resync && !_setupResyncBusy)
        {
            _setupResyncBusy = true;
            try
            {
                await ResyncAfterWizardAsync();
            }
            finally
            {
                _setupResyncBusy = false;
            }
        }
        if (!_disposed) RequestRender();
    });

    // Wizard chỉ ghi OcrDet/OcrRec/LlmActiveModel. Merge từng field theo baseline để edit chưa lưu
    // không bị mất; catalog luôn refresh, kể cả khi cả ba field đều đang dirty.
    private async Task ResyncAfterWizardAsync()
    {
        AppSettings current = SettingsStore.Load();
        (_ocrDetPick, _ocrDetBaseline) = SettingsPanelSync.MergeWizardField(
            _ocrDetPick, _ocrDetBaseline, current.OcrDet);
        (_ocrRecPick, _ocrRecBaseline) = SettingsPanelSync.MergeWizardField(
            _ocrRecPick, _ocrRecBaseline, current.OcrRec);
        (_llmActiveModel, _llmActiveModelBaseline) = SettingsPanelSync.MergeWizardField(
            _llmActiveModel, _llmActiveModelBaseline, current.LlmActiveModel);
        await LoadOcrModelsAsync();
        await LoadLlmModelsAsync();
        await LoadLlmRuntimeAsync();
        await LoadLlmServerStatusAsync();
    }

    public void Dispose()
    {
        _disposed = true; // chặn poll runtime gọi StateHasChanged sau khi sheet bị gỡ.
        L.Changed -= OnStateChanged;
        Js.OnWebViewReady -= OnStateChanged;
        Setup.Changed -= OnSetupChanged;
        Pipeline.StateChanged -= OnPipelineChanged;
    }
}
