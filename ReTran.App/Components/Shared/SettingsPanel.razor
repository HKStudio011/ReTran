    private async Task DeleteLlmModelAsync(LlmModelInfo model)
    {
        if (_llmModelsBusy) return;
        _llmModelsBusy = true;
        try
        {
            string[] installed = (_llmModels ?? [])
                .Where(candidate => candidate.Installed && candidate.Name != model.Name)
                .Select(candidate => candidate.Name)
                .ToArray();
            string[] engineActive = (_llmModels ?? [])
                .Where(candidate => candidate.InUse && candidate.Name != model.Name)
                .Select(candidate => candidate.Name)
                .ToArray();
            Setup.BeginModelDeletion(model.Name, installed, engineActive);
            await Pipeline.DeleteLlmModelAsync(model.Name, CancellationToken.None);
            Setup.RemoveDeletedModel(model.Name, installed, engineActive);
            AppSettings synchronized = SettingsStore.Load();
            _llmActiveModel = synchronized.LlmActiveModel;
            _llmActiveModelBaseline = synchronized.LlmActiveModel;
            Toast.Show(L.Fmt("deck.llm.deleted", model.Name));
            await LoadLlmModelsAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(L.Fmt("deck.llm.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _llmModelsBusy = false;
            RequestRender();
        }
    }

