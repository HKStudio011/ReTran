@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Nodes
@using ReTran_App.Core
@using ReTran_App.Services
@using ReTran_App.Services.Update
@inject ReTran_App.Services.I18nService L
@inject ReTran_App.Services.AppSettingsService SettingsStore
@inject PipelineController Pipeline
@* Fully-qualified: the Setup namespace also defines OcrModelInfo, which would clash with
   ReTran_App.Core.OcrModelInfo used throughout this panel. *@
@inject ReTran_App.Services.Setup.SetupCoordinator Setup
@inject UpdateCheckService Check
@inject UpdateCoordinator Coordinator
@inject ToastService Toast
@inject IAppUpdateService Updates
@inject JsInteropService Js
@implements IDisposable

<section class="rt-sect">
    <h3>@(L["deck.settings.section.provider"])</h3>
    <div class="rt-settings-group">
        <h4 class="rt-group-title">@(L["deck.settings.group.provider"])</h4>
        <div class="rt-srow">
            <span>@(L["deck.settings.provider"])</span>
            <div class="rt-select">
                <select @bind="_model.Provider" aria-label="@(L["deck.settings.provider"])">
                    <option value="google">@(L["settings.provider.google"])</option>
                    <option value="llm">@(L["settings.provider.llm"])</option>
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        <div class="rt-srow">
            <span>@(L["deck.settings.src"])</span>
            <div class="rt-select">
                <select @bind="_model.Src" aria-label="@(L["deck.settings.src"])">
                    @foreach (string lang in _srcOptions)
                    {
                        <option value="@lang">@(lang == "auto" ? L["settings.opt.auto"] : I18nStrings.LanguageName(lang))</option>
                    }
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        <div class="rt-srow">
            <span>@(L["deck.settings.dst"])</span>
            <div class="rt-select">
                <select @bind="_model.Dst" aria-label="@(L["deck.settings.dst"])">
                    @foreach (string lang in _dstOptions)
                    {
                        <option value="@lang">@(I18nStrings.LanguageName(lang))</option>
                    }
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        <p class="rt-hint">@(L["settings.note.srcNextStart"])</p>
    </div>

    @* LLM là nhóm con của cùng cấu hình dịch: mode Local/API, runtime/models và prompts. *@
    <div class="rt-settings-group">
        <h4 class="rt-group-title">@(L["deck.settings.group.llm"])</h4>
    <div class="rt-srow">
        <span>@(L["deck.llm.mode"])</span>
        <div class="rt-seg" role="group" aria-label="@(L["deck.llm.mode"])">
            <button type="button" aria-pressed="@Pressed(_llmMode == "local")" @onclick='() => _llmMode = "local"'>@(L["deck.llm.mode.local"])</button>
            <button type="button" aria-pressed="@Pressed(_llmMode == "api")" @onclick='() => _llmMode = "api"'>@(L["deck.llm.mode.api"])</button>
        </div>
    </div>

    @if (_llmMode == "local")
    {
        @* Hàng runtime: chọn flavor + trạng thái + Kiểm tra/Tải/Cập nhật (D9). *@
        <div class="rt-srow">
            <span>@(L["deck.llm.runtime.title"])</span>
            <div class="rt-select">
                <select value="@_llmFlavor" @onchange="OnLlmFlavorChanged" disabled="@_llmRuntimeBusy" aria-label="@(L["deck.llm.runtime.flavor"])">
                    <option value="cuda">@(L["deck.llm.runtime.flavor.cuda"])</option>
                    <option value="cpu">@(L["deck.llm.runtime.flavor.cpu"])</option>
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        <div class="rt-field-row" style="flex-wrap: wrap; gap: 10px; margin-bottom: 6px;">
            <button type="button" class="rt-btn rt-mini" disabled="@_llmRuntimeBusy" @onclick="CheckLlmRuntimeAsync">@(L["deck.llm.runtime.check"])</button>
            <button type="button" class="rt-btn rt-mini" disabled="@_llmRuntimeBusy" @onclick="DownloadLlmRuntimeAsync">@(L["deck.llm.runtime.download"])</button>
            @if (LlmUpdateAvailable)
            {
                <button type="button" class="rt-btn rt-btn-primary rt-mini" disabled="@_llmRuntimeBusy" @onclick="DownloadLlmRuntimeAsync">@(L.Fmt("deck.llm.runtime.update", _llmRuntimeCheck!.Latest!))</button>
            }
        </div>
        <p class="rt-hint" style="margin-bottom: 4px;">@LlmRuntimeText</p>
        <div class="rt-field-row" style="flex-wrap: wrap; gap: 8px; margin-bottom: 4px;">
            <p class="rt-hint" style="@(_llmServerStatusFailed || _llmServerStatus?.State == "error" ? "color: var(--rt-danger);" : "")">@LlmServerStatusText</p>
            <button type="button" class="rt-btn rt-mini" disabled="@_llmServerStatusBusy" @onclick="LoadLlmServerStatusAsync">@(L["deck.llm.refresh"])</button>
        </div>
        <p class="rt-hint" style="margin-bottom: 10px;">@(L["deck.llm.note.vram"])</p>

        @* Bảng model GGUF: tên/quant/size + trạng thái + Tải/Xoá/Đặt (mirror bảng OCR). *@
        @if (_llmModels is null)
        {
            <p class="rt-hint">@(_llmModelsFailed ? L["deck.llm.loadFailed"] : L["deck.llm.loading"])</p>
            @if (_llmModelsFailed)
            {
                <button type="button" class="rt-btn rt-mini" style="margin-top: 6px;" disabled="@_llmModelsBusy" @onclick="ReloadLlmModelsAsync">@(L["deck.llm.refresh"])</button>
            }
        }
        else
        {
            @if (_llmModelsFailed)
            {
                <p class="rt-hint" style="color: var(--rt-danger);">@(L["deck.llm.loadFailed"])</p>
            }
            <div class="rt-field-row" style="flex-wrap: wrap; gap: 10px; margin-bottom: 6px;">
                <span class="rt-hint">@(L.Fmt("deck.llm.activeModel", _llmActiveModel))</span>
                <button type="button" class="rt-btn rt-mini" disabled="@_llmModelsBusy" @onclick="ReloadLlmModelsAsync">@(L["deck.llm.refresh"])</button>
            </div>
            <table class="rt-model-table">
                <thead>
                    <tr style="color: var(--rt-dim); text-align: left;">
                        <th style="font-weight: 500; padding: 4px 8px 4px 0;">@(L["deck.llm.col.model"])</th>
                        <th style="font-weight: 500; padding: 4px 8px;">@(L["deck.llm.col.status"])</th>
                        <th style="font-weight: 500; padding: 4px 0; text-align: right;">@(L["deck.llm.col.actions"])</th>
                    </tr>
                </thead>
                <tbody>
                    @* Nhóm động theo lớp kích thước đọc từ catalog (spec 17-11 §11 — đồng bộ màn bước 4). *@
                    @foreach (IGrouping<string, LlmModelInfo> group in _llmModels.GroupBy(m => m.SizeClass))
                    {
                        <tr>
                            <td colspan="3" class="rt-model-group">@(L.Fmt("deck.llm.group", group.Key))</td>
                        </tr>
                        @foreach (LlmModelInfo m in group)
                        {
                            <tr style="border-top: 1px solid var(--rt-line);">
                                <td style="padding: 6px 8px 6px 0; vertical-align: top;">
                                    <div class="rt-mono">@m.Name</div>
                                    <div class="rt-hint">@LlmMetaText(m)</div>
                                </td>
                                <td style="padding: 6px 8px; vertical-align: top;">
                                    @if (m.Downloading)
                                    {
                                        <span class="rt-hint">@(L["deck.llm.downloading"])</span>
                                    }
                                    else
                                    {
                                        <span class="rt-hint" style="@(m.Installed ? "" : "color: var(--rt-danger)")">@(m.Installed ? L["deck.llm.installed"] : L["deck.llm.notInstalled"])</span>
                                    }
                                    @if (IsLlmActive(m))
                                    {
                                        <span class="rt-hint" style="color: var(--rt-tally)">· @(L["deck.llm.inUse"])</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(m.DownloadError))
                                    {
                                        <div class="rt-hint" style="color: var(--rt-danger); white-space: normal;">@(L.Fmt("deck.llm.modelDownloadFailed", m.DownloadError))</div>
                                    }
                                </td>
                                <td style="padding: 6px 0; text-align: right; vertical-align: top; white-space: nowrap;">
                                    <button type="button" class="rt-btn rt-mini" disabled="@(m.Installed || m.Downloading || _llmModelsBusy)" @onclick="() => DownloadLlmModelAsync(m)">@(L["deck.llm.download"])</button>
                                    <button type="button" class="rt-btn rt-mini" disabled="@(IsLlmActive(m) || m.Downloading || !m.Installed || _llmModelsBusy)" @onclick="() => DeleteLlmModelAsync(m)">@(L["deck.llm.delete"])</button>
                                    <button type="button" class="rt-btn rt-mini" disabled="@(IsLlmActive(m) || m.Downloading || !m.Installed || _llmModelsBusy)" @onclick="() => UseLlmModelAsync(m)">@(L["deck.llm.use"])</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    }
    else
    {
        @* Mode API: endpoint OpenAI-compatible (D9). *@
        <div class="rt-srow">
            <span>@(L["deck.llm.api.baseUrl"])</span>
            <input type="text" class="rt-input rt-mono" @bind="_llmBaseUrl"
                   placeholder="@(L["deck.llm.api.baseUrlHint"])" aria-label="@(L["deck.llm.api.baseUrl"])" />
        </div>
        <div class="rt-srow">
            <span>@(L["deck.llm.api.key"])</span>
            <input type="text" class="rt-input" @bind="_llmApiKey"
                   placeholder="@(L["deck.llm.api.keyHint"])" aria-label="@(L["deck.llm.api.key"])" />
        </div>
        <div class="rt-srow">
            <span>@(L["deck.llm.api.model"])</span>
            <input type="text" class="rt-input rt-mono" @bind="_llmApiModel"
                   placeholder="@(L["deck.llm.api.modelHint"])" aria-label="@(L["deck.llm.api.model"])" />
        </div>
    }

    @* Khối prompt: hiển thị mặc định Hy-MT2 khi chưa ghi đè (D11); khôi phục = nạp lại mặc định. *@
    <details open="true" class="rt-subcard" style="margin-top: 10px;">
        <summary style="cursor: pointer; font-size: 11.5px; color: var(--rt-dim); letter-spacing: .02em;">@(L["deck.llm.prompt.title"])</summary>
        <div style="margin-top: 10px;">
            <div class="rt-srow">
                <span>@(L["deck.llm.prompt.system"])</span>
                <textarea class="rt-input" style="height: auto; min-height: 52px; padding: 7px 10px; resize: vertical; line-height: 1.4;"
                          rows="2" @bind="_llmSystemPromptText" @bind:event="oninput"
                          aria-label="@(L["deck.llm.prompt.system"])"></textarea>
                <div class="rt-field-row">
                    <button type="button" class="rt-btn rt-mini" @onclick="RestoreLlmSystemPrompt">@(L["deck.llm.prompt.restore"])</button>
                </div>
            </div>
            <div class="rt-srow">
                <span>@(L["deck.llm.prompt.user"])</span>
                <textarea class="rt-input" style="height: auto; min-height: 96px; padding: 7px 10px; resize: vertical; line-height: 1.4;"
                          rows="5" @bind="_llmUserPromptText" @bind:event="oninput"
                          aria-label="@(L["deck.llm.prompt.user"])"></textarea>
                <div class="rt-field-row">
                    <button type="button" class="rt-btn rt-mini" @onclick="RestoreLlmUserPrompt">@(L["deck.llm.prompt.restore"])</button>
                </div>
            </div>
            <p class="rt-hint">@(L["deck.llm.prompt.placeholders"])</p>
        </div>
    </details>
        <p class="rt-hint" style="margin-top: 10px;">@(L["deck.llm.note.nextStart"])</p>
    </div>
    <div class="rt-actionbar">
        <button type="button" class="rt-btn rt-btn-primary" @onclick="Save">@(L["settings.btn.saveTranslation"])</button>
        @if (StatusText.Length > 0)
        {
            <span class="rt-hint" style="@(_statusKind == "saved" ? "" : "color: var(--rt-danger)")">@StatusText</span>
        }
        <span class="rt-hint">@(L["settings.note.saveScope"])</span>
    </div>
</section>

<section class="rt-sect">
    <h3>@(L["deck.settings.section.ocr"])</h3>
    <div class="rt-settings-group">
        <h4 class="rt-group-title">@(L["deck.settings.group.ocrModels"])</h4>
    @if (_ocrModels is null || _ocrModels.Count == 0)
    {
        <p class="rt-hint">@(_ocrLoadFailed ? L["deck.ocr.loadFailed"] : _ocrModels is null ? L["deck.ocr.loading"] : L["deck.ocr.empty"])</p>
        @if (_ocrModels is not null || _ocrLoadFailed)
        {
            <button type="button" class="rt-btn rt-mini" style="margin-top: 6px;" disabled="@_ocrBusy" @onclick="ReloadOcrModelsAsync">@(L["deck.ocr.refresh"])</button>
        }
    }
    else
    {
        <div class="rt-srow">
            <span>@(L["deck.settings.ocr.det"])</span>
            <div class="rt-select">
                <select @bind="_ocrDetPick" aria-label="@(L["deck.settings.ocr.det"])">
                    @foreach (OcrModelInfo m in _ocrModels.Where(m => m.Kind == "det"))
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        <div class="rt-srow">
            <span>@(L["deck.settings.ocr.rec"])</span>
            <div class="rt-select">
                <select @bind="_ocrRecPick" aria-label="@(L["deck.settings.ocr.rec"])">
                    @foreach (OcrModelInfo m in _ocrModels.Where(m => m.Kind == "rec"))
                    {
                        <option value="@m.Name">@m.Name</option>
                    }
                </select>
                <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
            </div>
        </div>
        @if (OcrSrcNotCovered is { } src)
        {
            <p class="rt-hint" style="color: var(--rt-danger); margin: 0 0 8px;">@(L.Fmt("deck.ocr.srcNotCovered", src))</p>
        }
        <p class="rt-hint" style="margin-bottom: 10px;">@OcrActivePairText @(L["deck.ocr.downloadHint"])</p>
        <table class="rt-model-table">
            <thead>
                <tr style="color: var(--rt-dim); text-align: left;">
                    <th style="font-weight: 500; padding: 4px 8px 4px 0;">@(L["deck.ocr.col.model"])</th>
                    <th style="font-weight: 500; padding: 4px 8px;">@(L["deck.ocr.col.status"])</th>
                    <th style="font-weight: 500; padding: 4px 0; text-align: right;">@(L["deck.ocr.col.actions"])</th>
                </tr>
            </thead>
            <tbody>
                @* Nhóm bảng theo vai trò (spec 17-11 §11): họ OCR v6, rec legacy (Ngôn ngữ), còn lại Khác. *@
                @foreach ((string groupKey, List<OcrModelInfo> group) in OcrTableGroups())
                {
                    <tr>
                        <td colspan="3" class="rt-model-group">@(L[groupKey])</td>
                    </tr>
                    @foreach (OcrModelInfo m in group)
                    {
                        <tr style="border-top: 1px solid var(--rt-line);">
                            <td style="padding: 6px 8px 6px 0; vertical-align: top;">
                                <div class="rt-mono">@m.Name</div>
                                <div class="rt-hint">@OcrMetaText(m)</div>
                            </td>
                            <td style="padding: 6px 8px; vertical-align: top;">
                                @if (m.Downloading)
                                {
                                    <span class="rt-hint">@OcrProgressText(m)</span>
                                }
                                else
                                {
                                    <span class="rt-hint" style="@(m.Installed ? "" : "color: var(--rt-danger)")">@(m.Installed ? L["deck.ocr.installed"] : L["deck.ocr.notInstalled"])</span>
                                }
                                @if (m.InUse)
                                {
                                    <span class="rt-hint" style="color: var(--rt-tally)">· @(L["deck.ocr.inUse"])</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.DownloadError))
                                {
                                    <div class="rt-hint" style="color: var(--rt-danger); white-space: normal;">@(L.Fmt("deck.ocr.downloadFailed", m.DownloadError))</div>
                                }
                            </td>
                            <td style="padding: 6px 0; text-align: right; vertical-align: top; white-space: nowrap;">
                                <button type="button" class="rt-btn rt-mini" disabled="@(m.Installed || m.Downloading || _ocrBusy)" @onclick="() => DownloadOcrModelAsync(m)">@(L["deck.ocr.download"])</button>
                                <button type="button" class="rt-btn rt-mini" disabled="@(m.InUse || !m.Installed || _ocrBusy)" @onclick="() => DeleteOcrModelAsync(m)">@(L["deck.ocr.delete"])</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
    @if (_ocrModels is { Count: > 0 })
    {
        <div class="rt-actionbar">
            <button type="button" class="rt-btn rt-btn-primary rt-mini" disabled="@_ocrBusy" @onclick="SaveOcrPairAsync">@(L["deck.ocr.savePair"])</button>
            <button type="button" class="rt-btn rt-mini" disabled="@_ocrBusy" @onclick="ReloadOcrModelsAsync">@(L["deck.ocr.refresh"])</button>
        </div>
    }
    </div>

    <div class="rt-settings-group">
        <h4 class="rt-group-title">@(L["deck.ocr.params.title"])</h4>
    @* Tham số máy OCR: render động từ schema sidecar (spec §8) — nhãn/hint/tip i18n theo key. *@
    @if (_ocrSchema is null)
    {
        <p class="rt-hint" style="margin-top: 12px;">@(_ocrSchemaFailed ? L["deck.ocr.params.loadFailed"] : L["deck.ocr.loading"])</p>
        @if (_ocrSchemaFailed)
        {
            <button type="button" class="rt-btn rt-mini" style="margin-top: 6px;" disabled="@_ocrParamsBusy" @onclick="ReloadOcrSchemaAsync">@(L["deck.ocr.refresh"])</button>
        }
    }
    else
    {
        @if (_ocrSchemaFailed)
        {
            <p class="rt-hint" style="color: var(--rt-danger);">@(L["deck.ocr.params.loadFailed"])</p>
        }
        @foreach (IGrouping<string, OcrParamSpec> group in _ocrSchema.GroupBy(p => p.Group))
        {
            <details open="@(group.Key is not ("device" or "models"))"
                     class="rt-subcard" style="margin-bottom: 8px;">
                <summary style="cursor: pointer; font-size: 11.5px; color: var(--rt-dim); letter-spacing: .02em;">@(L["ocr.group." + group.Key])</summary>
                <div style="margin-top: 10px;">
                    @foreach (OcrParamSpec p in group)
                    {
                        string label = L["ocr.param." + p.Key + ".label"];
                        <div class="rt-srow" title="@(L["ocr.param." + p.Key + ".tip"])">
                            <span>@label</span>
                            @if (p.Type == "bool")
                            {
                                <input type="checkbox" @bind="_ocrBool[p.Key]" aria-label="@label" />
                            }
                            else if (p.Type == "enum")
                            {
                                <div class="rt-select">
                                    <select @bind="_ocrText[p.Key]" aria-label="@label">
                                        @if (p.Default is null)
                                        {
                                            <option value="">@(L["settings.opt.auto"])</option>
                                        }
                                        @foreach (string option in p.Values)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                    <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            }
                            else if (p.Type == "json")
                            {
                                <textarea class="rt-input rt-mono" rows="3"
                                          style="height: auto; min-height: 68px; padding: 7px 10px; resize: vertical; line-height: 1.4;"
                                          placeholder="@OcrPlaceholder(p)" @bind="_ocrText[p.Key]" @bind:event="oninput"
                                          aria-label="@label" aria-invalid="@(_ocrFieldErrors.ContainsKey(p.Key))"></textarea>
                            }
                            else if (p.Type is "int" or "float")
                            {
                                <input type="number" class="rt-input rt-mono"
                                       min="@FormatBound(p.Min)" max="@FormatBound(p.Max)" step="@FormatBound(p.Step)"
                                       placeholder="@OcrPlaceholder(p)" @bind="_ocrText[p.Key]" aria-label="@label" />
                            }
                            else
                            {
                                <input type="text" class="rt-input" placeholder="@OcrPlaceholder(p)"
                                       @bind="_ocrText[p.Key]" aria-label="@label" />
                            }
                            <p class="rt-hint">@(L["ocr.param." + p.Key + ".hint"])</p>
                            @if (_ocrFieldErrors.TryGetValue(p.Key, out string? fieldError))
                            {
                                <p class="rt-hint" style="color: var(--rt-danger);">@(L["ocr.param.error." + fieldError])</p>
                            }
                        </div>
                    }
                </div>
            </details>
        }
        @* Nhịp OCR: 2 tham số pipeline (không thuộc schema sidecar), chỉ áp dụng ở core.start kế tiếp. *@
        <details open="true"
                 class="rt-subcard" style="margin-bottom: 8px;">
            <summary style="cursor: pointer; font-size: 11.5px; color: var(--rt-dim); letter-spacing: .02em;">@(L["ocr.group.rhythm"])</summary>
            <div style="margin-top: 10px;">
                <div class="rt-srow">
                    <span>@(L["deck.ocr.rhythm.ocrFps"])</span>
                    <input type="number" class="rt-input rt-mono" min="1" max="60" step="1"
                           aria-label="@(L["deck.ocr.rhythm.ocrFps"])" @bind="_ocrFpsText" />
                </div>
                <div class="rt-srow">
                    <span>@(L["deck.ocr.rhythm.captureFps"])</span>
                    <input type="number" class="rt-input rt-mono" min="1" max="60" step="1"
                           aria-label="@(L["deck.ocr.rhythm.captureFps"])" @bind="_captureFpsText" />
                </div>
                <p class="rt-hint">@(L["deck.ocr.rhythm.note"])</p>
            </div>
        </details>
        <div class="rt-srow">
            <span>@(L["deck.ocr.mergeLines.label"])</span>
            <input type="checkbox" @bind="_mergeLines" aria-label="@L["deck.ocr.mergeLines.label"]" />
            <p class="rt-hint">@(L["deck.ocr.mergeLines.hint"])</p>
        </div>
        @* Ba ngưỡng gộp dòng: chỉ nhập được khi Gộp nhiều dòng đang bật; giá trị vẫn được lưu
           kể cả khi tắt (hành vi như hôm nay). type="text" + inputmode có chủ đích — ô number
           không nhận dạng dấu phẩy thập phân ("0,6") mà TryParseRatio chấp nhận. *@
        <div class="rt-srow rt-srow--num">
            <span>@(L["deck.ocr.mergeGap.label"])</span>
            <input type="text" class="rt-input rt-mono" inputmode="decimal"
                   aria-label="@(L["deck.ocr.mergeGap.label"])"
                   disabled="@(!_mergeLines)" @bind="_mergeGapText" />
            <p class="rt-hint">@(L["deck.ocr.mergeGap.hint"])</p>
        </div>
        <div class="rt-srow rt-srow--num">
            <span>@(L["deck.ocr.mergeHeight.label"])</span>
            <input type="text" class="rt-input rt-mono" inputmode="decimal"
                   aria-label="@(L["deck.ocr.mergeHeight.label"])"
                   disabled="@(!_mergeLines)" @bind="_mergeHeightText" />
            <p class="rt-hint">@(L["deck.ocr.mergeHeight.hint"])</p>
        </div>
        <div class="rt-srow rt-srow--num">
            <span>@(L["deck.ocr.mergeOverlap.label"])</span>
            <input type="text" class="rt-input rt-mono" inputmode="decimal"
                   aria-label="@(L["deck.ocr.mergeOverlap.label"])"
                   disabled="@(!_mergeLines)" @bind="_mergeOverlapText" />
            <p class="rt-hint">@(L["deck.ocr.mergeOverlap.hint"])</p>
        </div>
        <div class="rt-actionbar">
            <button type="button" class="rt-btn rt-btn-primary" disabled="@(_ocrParamsBusy || !SettingsPanelSync.CanSaveOcrParams(_ocrSchema, _ocrSchemaFailed))" @onclick="SaveOcrParamsAsync">@(L["deck.ocr.params.save"])</button>
            <button type="button" class="rt-btn rt-mini" disabled="@(_ocrParamsBusy || !SettingsPanelSync.CanSaveOcrParams(_ocrSchema, _ocrSchemaFailed))" @onclick="RestoreOcrParamsAsync">@(L["deck.ocr.params.restore"])</button>
            @if (_ocrStatusText.Length > 0)
            {
                <span class="rt-hint" style="@(_ocrStatusError ? "color: var(--rt-danger)" : "")">@_ocrStatusText</span>
            }
        </div>
    }
    </div>
</section>

<section class="rt-sect">
    <h3>@(L["deck.settings.section.look"])</h3>
