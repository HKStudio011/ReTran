    private async Task SaveOcrPairAsync()
    {
        if (_ocrBusy) return;
        _ocrBusy = true;
        try
        {
            // Cặp đã chọn phải vào settings.json trước tiên — core.start lần sau gửi đúng cặp
            // này kể cả khi bên dưới bị hoãn (đang chạy thì không đổi model giữa phiên, C8).
            SettingsStore.Save(SettingsStore.Load() with { OcrDet = _ocrDetPick, OcrRec = _ocrRecPick });
            // C8: pipeline đang chạy → không gọi ocr.models.set (sidecar giữ predictor đang
            // nạp; đổi giữa phiên tốn nạp lại cả model, đo được tới 27,1 s) — cặp mới áp dụng
            // ở lần start kế tiếp.
            bool appliedNow = await Pipeline.ApplyOcrPairIfIdleAsync(_ocrDetPick, _ocrRecPick, CancellationToken.None);
            Toast.Show(appliedNow ? L["deck.ocr.pairSaved"] : L["deck.ocr.pairDeferred"]);
            await LoadOcrModelsAsync();
        }
        catch (Exception ex)
        {
            Toast.Show(L.Fmt("deck.ocr.actionFailed", ex.Message), ToastSeverity.Error);
        }
        finally
        {
            _ocrBusy = false;
            StateHasChanged();
        }
    }

    // Nạp schema tham số engine từ Core; lỗi → thông báo + nút Làm mới, không làm chết trang.
    private async Task LoadOcrSchemaAsync()
    {
        try
        {
            IReadOnlyList<OcrParamSpec> schema = await Pipeline.GetOcrConfigSchemaAsync(CancellationToken.None);
            _ocrSchema = schema;
            _ocrSchemaFailed = false;
            ApplySettingsToOcrState();
        }
        catch (Exception)
        {
            // Core/sidecar chưa sẵn sàng — giữ schema cũ (nếu có), bấm Làm mới thử lại.
            _ocrSchemaFailed = true;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadOcrSchemaAsync()
    {
        if (_ocrParamsBusy) return;
        _ocrParamsBusy = true;
        try
        {
            await LoadOcrSchemaAsync();
        }
        finally
        {
            _ocrParamsBusy = false;
            StateHasChanged();
        }
    }

    // Giá trị đã lưu trong settings.json (C9: nguồn duy nhất cho giá trị đang dùng) → control.
    private void ApplySettingsToOcrState()
    {
        AppSettings settings = SettingsStore.Load();
        _ocrValues = new Dictionary<string, JsonNode?>(settings.OcrEngine ?? new Dictionary<string, JsonNode?>());
        ApplyOcrValuesToControls();
        _ocrFpsText = settings.OcrFps.ToString(CultureInfo.InvariantCulture);
        _captureFpsText = settings.CaptureFps.ToString(CultureInfo.InvariantCulture);
        _mergeLines = settings.OcrMergeLines;
        _mergeGapText = FormatThreshold(settings.OcrMergeGap);
        _mergeHeightText = FormatThreshold(settings.OcrMergeHeight);
        _mergeOverlapText = FormatThreshold(settings.OcrMergeOverlap);
        SetOcrStatus(string.Empty, isError: false);
    }

    // Đổ _ocrValues + default schema vào control — không đọc lại file (Restore dùng chung).
    private void ApplyOcrValuesToControls()
    {
        if (_ocrSchema is null) return;
        _ocrText.Clear();
        _ocrBool.Clear();
        foreach (OcrParamSpec spec in _ocrSchema)
        {
            JsonNode? value = _ocrValues.TryGetValue(spec.Key, out JsonNode? stored) && stored is not null
                ? stored
                : spec.Default;
            if (spec.Type == "bool")
            {
                _ocrBool[spec.Key] = ReadBoolNode(value) ?? false;
            }
            else
            {
                _ocrText[spec.Key] = FormatOcrValue(spec, value);
            }
        }
    }

    // Lưu cả khối: validate → ocr.config.set → chỉ ghi settings.json khi set thành công (C14).
    private async Task SaveOcrParamsAsync()
    {
        if (_ocrParamsBusy || _ocrSchema is null) return;
        _ocrParamsBusy = true;
        try
        {
            var map = new Dictionary<string, JsonNode?>();
            foreach (OcrParamSpec spec in _ocrSchema)
            {
                string? error = BuildOcrWireValue(spec, out JsonNode? value);
                if (error is not null)
                {
                    SetOcrStatus(L.Fmt("deck.ocr.params.invalid", L["ocr.param." + spec.Key + ".label"],
                        L["ocr.param.error." + error]), isError: true);
                    return;
                }
                // Key vắng = mặc định (replace, C12): bỏ null/giá trị trùng default để không ghim (C5).
                if (!IsOcrOverride(spec, value)) continue;
                map[spec.Key] = value;
            }
            if (!TryParseOcrFps(_ocrFpsText, out int ocrFps))
            {
                SetOcrStatus(L.Fmt("deck.ocr.params.invalid", L["deck.ocr.rhythm.ocrFps"],
                    L["ocr.param.error.range"]), isError: true);
                return;
            }
            if (!TryParseOcrFps(_captureFpsText, out int captureFps))
            {
                SetOcrStatus(L.Fmt("deck.ocr.params.invalid", L["deck.ocr.rhythm.captureFps"],
                    L["ocr.param.error.range"]), isError: true);
                return;
            }
            // Ngưỡng gộp dòng: parse cả ba trước khi ghi gì cả — sai dải thì không Save,
            // không ocr.config.set (sheet đang hiển thị theo culture nên "0,6" là hợp lệ).
            if (!OcrMergeThresholds.TryParseRatio(_mergeGapText, out double mergeGap)
                || !OcrMergeThresholds.TryParseRatio(_mergeHeightText, out double mergeHeight)
                || !OcrMergeThresholds.TryParseRatio(_mergeOverlapText, out double mergeOverlap)
                || !OcrMergeThresholds.AllValid(mergeGap, mergeHeight, mergeOverlap))
            {
                SetOcrStatus(L["deck.ocr.mergeThresholds.invalid"], isError: true);
                return;
            }

            OcrConfigSetResult result = await Pipeline.SetOcrConfigAsync(map, CancellationToken.None);
            SettingsStore.Save(SettingsStore.Load() with
            {
                OcrEngine = map,
                OcrFps = ocrFps,
                CaptureFps = captureFps,
                OcrMergeLines = _mergeLines,
                OcrMergeGap = mergeGap,
                OcrMergeHeight = mergeHeight,
                OcrMergeOverlap = mergeOverlap,
            });
            _ocrValues = new Dictionary<string, JsonNode?>(map);
            SetOcrStatus(L[result.Deferred.Count > 0 ? "deck.ocr.params.deferred" : "deck.ocr.params.applied"],
                isError: false);
            Toast.Show(_ocrStatusText);
        }
        catch (Exception)
        {
            // Set lỗi (sidecar từ chối/không sẵn sàng) → giữ nguyên file để lần Start sau không
            // dính giá trị bị từ chối (C14).
            SetOcrStatus(L["deck.ocr.params.saveFailed"], isError: true);
        }
        finally
        {
            _ocrParamsBusy = false;
            StateHasChanged();
        }
    }

    // Khôi phục mặc định: control về default schema rồi lưu như thường — map rỗng = sidecar reset (C12).
    private async Task RestoreOcrParamsAsync()
    {
        if (_ocrParamsBusy) return;
        _ocrValues.Clear();
        ApplyOcrValuesToControls();
        _mergeLines = AppSettings.Default.OcrMergeLines; // restore đưa cả cờ gộp dòng về mặc định.
        _mergeGapText = FormatThreshold(OcrMergeThresholds.DefaultGap);
        _mergeHeightText = FormatThreshold(OcrMergeThresholds.DefaultHeight);
        _mergeOverlapText = FormatThreshold(OcrMergeThresholds.DefaultOverlap);
        await SaveOcrParamsAsync();
    }

    // Dựng giá trị wire từ control của một dòng; trả mã lỗi (ocr.param.error.*) khi ô nhập sai,
    // null khi dựng được — value null nghĩa là "không set" (key vắng = mặc định).
    private string? BuildOcrWireValue(OcrParamSpec spec, out JsonNode? value)
    {
        value = null;
        switch (spec.Type)
        {
            case "bool":
                value = JsonValue.Create(_ocrBool.GetValueOrDefault(spec.Key));
                break;
            case "enum":
            case "string":
            {
                string text = _ocrText.GetValueOrDefault(spec.Key, string.Empty);
                if (string.IsNullOrWhiteSpace(text)) return null;
                value = JsonValue.Create(text);
                break;
            }
            case "int":
            {
                string text = _ocrText.GetValueOrDefault(spec.Key, string.Empty);
                if (string.IsNullOrWhiteSpace(text)) return null;
                if (!int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out int number))
                {
                    return "type";
                }
                value = JsonValue.Create(number);
                break;
            }
            case "float":
            {
                string text = _ocrText.GetValueOrDefault(spec.Key, string.Empty);
                if (string.IsNullOrWhiteSpace(text)) return null;
                if (!double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out double number))
                {
                    return "type";
                }
                value = JsonValue.Create(number);
                break;
            }
            case "json":
            {
                // Ô trống = không set (default null hiển thị trống — ví dụ engine_config).
                string text = _ocrText.GetValueOrDefault(spec.Key, string.Empty);
                if (string.IsNullOrWhiteSpace(text)) return null;
                if (!OcrConfigValidation.TryParseJsonObject(text, out JsonObject? obj, out string? jsonError))
                {
                    return jsonError;
                }
                value = obj;
                break;
            }
            case "shape":
            {
                // Ô trống = không set (default null hiển thị trống — ví dụ text_det_input_shape).
                string text = _ocrText.GetValueOrDefault(spec.Key, string.Empty);
                if (string.IsNullOrWhiteSpace(text)) return null;
                if (!OcrConfigValidation.TryParseShape(text, out JsonArray? shape, out string? shapeError))
                {
                    return shapeError;
                }
                value = shape;
                break;
            }
            default:
                return "type";
        }
        return value is null ? null : OcrConfigValidation.Validate(spec, value);
    }

    // Có gửi key lên wire không: null (không set) và giá trị trùng default schema bị bỏ (C5);
    // riêng bool default null (enable_hpi) + bỏ tick cũng bị bỏ vì null = engine tự quyết.
    private static bool IsOcrOverride(OcrParamSpec spec, JsonNode? value)
    {
        if (value is null || JsonNode.DeepEquals(value, spec.Default)) return false;
        return spec.Type != "bool" || spec.Default is not null || value.GetValueKind() != JsonValueKind.False;
    }

    private void SetOcrStatus(string text, bool isError)
    {
        _ocrStatusText = text;
        _ocrStatusError = isError;
    }

    private static bool TryParseOcrFps(string text, out int value) =>
        int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out value)
        && value is >= 1 and <= 60;

    // Hiển thị ngưỡng trong ô chữ theo invariant culture (inverso của TryParseRatio); giá trị
    // hiển thị ngắn nhất round-trip nên 0.6 → "0.6", 1.35 → "1.35".
    private static string FormatThreshold(double value) => value.ToString(CultureInfo.InvariantCulture);

    private static bool? ReadBoolNode(JsonNode? node) =>
        node is JsonValue value && value.GetValueKind() is JsonValueKind.True or JsonValueKind.False
            && value.TryGetValue(out bool flag)
                ? flag
                : null;

    private static string? FormatBound(double? value) => value?.ToString(CultureInfo.InvariantCulture);

    private static string OcrPlaceholder(OcrParamSpec spec) =>
        spec.Placeholder ?? OcrConfigValidation.FormatDefault(spec) ?? string.Empty;

    // Hiển thị giá trị JSON trong ô chữ: shape → N,C,H,W, chuỗi → trần, còn lại → JSON gọn.
    private static string FormatOcrValue(OcrParamSpec spec, JsonNode? value)
    {
        if (value is null) return string.Empty;
        if (spec.Type == "shape" && value is JsonArray array)
        {
            return string.Join(",", array.Select(e => e?.ToJsonString() ?? string.Empty));
        }
        if (value is JsonValue json && json.GetValueKind() == JsonValueKind.String)
        {
            return json.GetValue<string>();
        }
        return value.ToJsonString();
    }

