    // Popup "Bỏ qua" (spec 2026-11-13): mở popup thay vì đóng app ngay.
    private void ShowSkipConfirm()
    {
        if (_busy) return;
        _showSkipConfirm = true;
    }

    // [Thoát ReTran] — đúng hành vi Skip cũ: đóng app sạch qua closeApp, không ghi state. Cùng guard
    // _busy như các nút sibling: modal không được nhận lệnh thứ hai trong lúc closeApp đang chạy.
    private void ConfirmExit()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            Coordinator.Skip();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // [Bỏ qua thiết lập] — ẩn wizard tới hết phiên + mở gate; modal tự ẩn qua điều kiện render.
    private void ConfirmSkipForSession()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            Coordinator.SkipForSession();
        }
        finally
        {
            // Reset luôn trạng thái popup: lượt "Chạy lại setup" sau đó làm modal hiện lại — popup cũ
            // (kèm nút [Thoát ReTran]) không được hồi sinh trên đầu wizard vừa chạy lại.
            // Also reset the popup state: a later "re-run setup" makes the modal visible again — the old
            // popup (with its [Exit ReTran] button) must not resurrect over the re-running wizard.
            _showSkipConfirm = false;
            _busy = false;
            StateHasChanged();
        }
    }

    // [Quay lại] — đóng popup, về màn lỗi như cũ.
    private void BackFromSkipConfirm()
    {
        if (_busy) return;
        _showSkipConfirm = false;
        StateHasChanged();
    }
}
