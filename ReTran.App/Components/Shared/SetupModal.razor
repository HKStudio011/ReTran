@* Modal setup toàn màn hình chạy lần đầu — điểm entry duy nhất của wizard (spec §5.9): tự trigger
   trong OnInitialized khi state chưa xong hoặc artifact đã mất; render rỗng khi wizard hoàn tất hoặc
   user đã "bỏ qua thiết lập" cho phiên này (spec 2026-11-13).
   Mọi hành động đi qua SetupCoordinator — modal KHÔNG gọi uv/python/sidecar trực tiếp (spec §5.11). *@
@using ReTran_App.Core
@using ReTran_App.Services
@using ReTran_App.Services.Setup
@implements IDisposable
@inject SetupCoordinator Coordinator
@inject I18nService L
@inject AppSettingsService SettingsStore
@inject PipelineController Pipeline

@if (_wizardActive && !Coordinator.IsComplete && !Coordinator.SkippedForSession)
{
    @* Keyframes cho progress bar indeterminate (uv sync có thể kéo dài vài phút). Định nghĩa tại đây
       thay vì Vite build: modal không được phụ thuộc rebuild frontend. *@
    <style>
        .rt-setup-modal .rt-setup-track { position: relative; height: 8px; border-radius: 4px; background: var(--rt-line); overflow: hidden; margin-top: 12px; }
        .rt-setup-modal .rt-setup-bar { position: absolute; top: 0; bottom: 0; left: -40%; width: 40%; border-radius: 4px; background: var(--rt-tally); animation: rt-setup-sweep 1.4s ease-in-out infinite; }
        @@keyframes rt-setup-sweep { from { left: -40%; } to { left: 100%; } }

        @* Checklist live bước Checking (2026-11-15). Màu chữ dùng CÙNG họ biến với vỏ modal
           (--surface trên bg-background) để tương phản đúng cả 2 theme kể cả khi data-theme chưa set;
           chú thích dùng --rt-dim (đậm hơn --rt-faint cho cỡ 11px). *@
        .rt-setup-modal .setup-checks { list-style: none; margin: 10px 0 0; padding: 0 4px 0 0; display: grid; gap: 7px; max-height: 264px; overflow-y: auto; }
        .rt-setup-modal .setup-checks li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; align-items: start; font-size: 12.5px; line-height: 1.45; color: var(--surface); }
        .rt-setup-modal .setup-checks .mark { display: inline-grid; place-items: center; width: 18px; height: 18px; font-size: 12px; }
        .rt-setup-modal .setup-checks .body { display: grid; gap: 1px; min-width: 0; }
        .rt-setup-modal .setup-checks .lbl { overflow-wrap: anywhere; }
        .rt-setup-modal .setup-checks .det { color: var(--rt-dim); font-size: 11px; overflow-wrap: anywhere; }
        .rt-setup-modal .setup-checks li.ok .mark { color: var(--rt-data); }
        .rt-setup-modal .setup-checks li.warn .mark { color: var(--rt-tally); }
        .rt-setup-modal .setup-checks li.warn .det { color: var(--rt-tally); }
        .rt-setup-modal .setup-checks li.fail .mark { color: var(--rt-danger); }
        .rt-setup-modal .setup-checks li.fail .det { color: var(--rt-danger); }
        .rt-setup-modal .setup-checks li.pending, .rt-setup-modal .setup-checks li.pending .det { color: var(--rt-dim); }
        .rt-setup-modal .setup-checks li.pending .mark { color: var(--rt-faint); }
        .rt-setup-modal .rt-spinner { width: 11px; height: 11px; border-radius: 50%; border: 1.6px solid var(--rt-line2); border-top-color: var(--rt-tally); display: inline-block; animation: rt-setup-spin 0.9s linear infinite; margin-top: 3px; }
        @@keyframes rt-setup-spin { to { transform: rotate(360deg); } }

        @* Bảng chọn 2 màn mới (2026-11-16, mockup A1–A4/B1–B3): cùng họ biến với vỏ modal như checklist;
           dòng đã cài dùng tag + checkbox disabled (chỉ khoá checkbox — radio vẫn chọn được). *@
        .rt-setup-modal .setup-choices { list-style: none; margin: 10px 0 0; padding: 0 4px 0 0; display: grid; gap: 7px; max-height: 300px; overflow-y: auto; }
        .rt-setup-modal .setup-choices li { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto; gap: 8px; align-items: center; font-size: 12.5px; line-height: 1.45; color: var(--surface); }
        .rt-setup-modal .setup-choices input[type=checkbox] { width: 15px; height: 15px; margin: 0; accent-color: var(--rt-tally); cursor: pointer; }
        .rt-setup-modal .setup-choices input[type=checkbox]:disabled { cursor: default; opacity: .75; }
        .rt-setup-modal .setup-choices .body { display: grid; gap: 1px; min-width: 0; align-self: start; padding-top: 1px; }
        .rt-setup-modal .setup-choices .lbl { overflow-wrap: anywhere; }
        .rt-setup-modal .setup-choices .det { color: var(--rt-dim); font-size: 11px; overflow-wrap: anywhere; font-family: var(--rt-mono); }
        .rt-setup-modal .setup-choices .use { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; color: var(--rt-dim); white-space: nowrap; cursor: pointer; }
        .rt-setup-modal .setup-choices .use input[type=radio] { margin: 0; accent-color: var(--rt-tally); cursor: pointer; }
        .rt-setup-modal .setup-choices .use.on { color: var(--rt-tally); font-weight: 600; }
        .rt-setup-modal .tag-installed { display: inline-block; font-size: 10px; color: var(--rt-data); border: 1px solid currentColor; border-radius: 99px; padding: 0 6px; line-height: 1.7; white-space: nowrap; vertical-align: 1px; margin-left: 4px; }
        .rt-setup-modal .setup-hintline { margin: 8px 0 0; color: var(--rt-dim); font-size: 11px; line-height: 1.6; }
        .rt-setup-modal .setup-total { margin: 10px 0 0; color: var(--rt-dim); font-size: 11.5px; }
        .rt-setup-modal .setup-warn { margin: 8px 0 0; color: var(--rt-danger); font-size: 11.5px; }

        @* Khối det/rec (bước 2) + tiến độ tải (bước 8/9) — vòng 2, mockup detrec-langs-llm đã duyệt. *@
        .rt-setup-modal .setup-sect { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--rt-line); }
        .rt-setup-modal .setup-sect .sect-lbl { display: block; font-size: 11px; font-weight: 600; letter-spacing: .03em; color: var(--rt-dim); text-transform: uppercase; }
        .rt-setup-modal .setup-downloads { list-style: none; margin: 10px 0 0; padding: 0 4px 0 0; display: grid; gap: 6px; }
        .rt-setup-modal .setup-downloads .det { color: var(--rt-dim); font-size: 11px; overflow-wrap: anywhere; }
        .rt-setup-modal .setup-downloads .mono { font-family: var(--rt-mono); }
    </style>

    @* z-index 60 inline (lớn hơn z-50 của .rt-sheet): settings sheet đứng sau trong DOM nên với cùng
       z-index nó sẽ phủ lên modal — nút "Chạy lại setup" phải để wizard hiện trên sheet. Toasts (z-70)
       vẫn nổi trên cùng. *@
    <div class="fixed inset-0 flex items-center justify-center bg-black/50 p-4" style="z-index: 60;">
        <div role="dialog" aria-modal="true" aria-label="@ModalTitle"
             class="rt-setup-modal w-full max-w-lg rounded-lg border border-surface bg-background p-4 shadow-xl">
            <h2 class="mb-3 text-base font-semibold text-surface">@ModalTitle</h2>

            @switch (Coordinator.Step)
            {
                case SetupStep.Checking:
                    <p class="text-sm text-surface">@(L["setup.checking"])</p>
                    @* Checklist live: SystemCheck phát từng mục (Pending → Running → kết quả). Cảnh báo hạ
                       GPU→CPU nằm trong dòng gpu (Warn) — khối paragraph Notice cũ đã bỏ (2026-11-15). *@
                    @if (Coordinator.Checks.Count > 0)
                    {
                        <ul class="setup-checks">
                            @foreach (SetupCheckItem item in Coordinator.Checks)
                            {
                                <li class="@CheckItemClass(item.State)">
                                    <span class="mark">
                                        @if (item.State == SetupCheckState.Running)
                                        {
                                            <span class="rt-spinner" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            @CheckGlyph(item.State)
                                        }
                                    </span>
                                    <span class="body">
                                        <span class="lbl">@L.Fmt(item.Label.Key, item.Label.Args.ToArray())</span>
                                        @if (item.Detail is { } detail)
                                        {
                                            <span class="det">@L.Fmt(detail.Key, detail.Args.ToArray())</span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    break;

                case SetupStep.ChoosingOcrModels:
                    @* Bước 2 (spec 17-11 §4): 2 khối det/rec, tick nhiều + ≥ 1 mỗi khối; dòng đã cài tick
                       sẵn + KHOÁ; chấm "Dùng chính" mỗi khối; tổng tải = phần còn thiếu. *@
                    <p class="text-sm text-surface">@(L["setup.models.title"]) <span class="rt-hint">@(L["setup.models.hint"])</span></p>
                    <div class="setup-sect">
                        <span class="sect-lbl">@(L["setup.models.det.sect"])</span>
                        <ul class="setup-choices">
                            @foreach (string name in OcrModelChoices.DetModels())
                            {
                                bool locked = _detLocked.Contains(name);
                                float missing = ModelRowMissingMb(name);
                                <li>
                                    <input type="checkbox" checked="@_detTicks.Contains(name)" disabled="@locked" @onchange='() => ToggleDet(name)' />
                                    <span class="body">
                                        <span class="lbl">
                                            @RowLabel(name)
                                            @if (locked)
                                            {
                                                <span class="tag-installed">@(L["setup.models.installed"])</span>
                                            }
                                        </span>
                                        <span class="det">@ModelMeta(name)</span>
                                        @if (missing > 0)
                                        {
                                            <span class="det">@(L.Fmt("setup.models.willDownload", FormatMb(missing)))</span>
                                        }
                                    </span>
                                    @if (_detTicks.Contains(name))
                                    {
                                        <label class="@(_activeDetPick == name ? "use on" : "use")">
                                            <input type="radio" name="setup-det" checked="@(_activeDetPick == name)" @onchange='() => PickActiveDet(name)' />
                                            @(L["setup.models.use"])
                                        </label>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="setup-sect">
                        <span class="sect-lbl">@(L["setup.models.rec.sect"])</span>
                        <ul class="setup-choices">
                            @foreach (string name in OcrModelChoices.RecModels())
                            {
                                bool locked = _recLocked.Contains(name);
                                float missing = ModelRowMissingMb(name);
                                <li>
                                    <input type="checkbox" checked="@_recTicks.Contains(name)" disabled="@locked" @onchange='() => ToggleRec(name)' />
                                    <span class="body">
                                        <span class="lbl">
                                            @RowLabel(name)
                                            @if (locked)
                                            {
                                                <span class="tag-installed">@(L["setup.models.installed"])</span>
                                            }
                                        </span>
                                        <span class="det">@ModelMeta(name)</span>
                                        @if (missing > 0)
                                        {
                                            <span class="det">@(L.Fmt("setup.models.willDownload", FormatMb(missing)))</span>
                                        }
                                    </span>
                                    @if (_recTicks.Contains(name))
                                    {
                                        <label class="@(_activeRecPick == name ? "use on" : "use")">
                                            <input type="radio" name="setup-rec" checked="@(_activeRecPick == name)" @onchange='() => PickActiveRec(name)' />
                                            @(L["setup.models.use"])
                                        </label>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                    <p class="setup-total">@(L.Fmt("setup.models.total", FormatMb(_detTicks.Sum(ModelRowMissingMb) + _recTicks.Sum(ModelRowMissingMb))))</p>
                    @if (_detTicks.Count == 0 || _recTicks.Count == 0)
                    {
                        <p class="setup-warn">@(L["setup.models.minOne"])</p>
                    }
                    <button type="button" class="rt-btn rt-btn-primary" disabled="@(_busy || _detTicks.Count == 0 || _recTicks.Count == 0)" @onclick="ConfirmOcrModelsAsync">@(L["setup.next"])</button>
                    break;

                case SetupStep.ChoosingLanguages:
                    @* Bước 3 (spec 17-11 §5): ngôn ngữ ngoài phủ v6 — tick nhiều hoặc để trống; rec đã cài
                       tick sẵn + KHOÁ; chấm "Đọc chính" đổi rec đang chạy (trống ⇒ không chấm). *@
                    <p class="text-sm text-surface">@(L["setup.langs.title"]) <span class="rt-hint">@(L["setup.langs.hint"])</span></p>
                    <p class="setup-hintline">@(L["setup.langs.note"])</p>
                    <ul class="setup-choices">
                        @foreach (LanguageChoice choice in OcrModelChoices.LanguageChoices())
                        {
                            string rec = _langVariantPick[choice.PrimaryLang];
                            bool locked = _langLocked.Contains(rec);
                            float missing = ModelRowMissingMb(rec);
                            <li>
                                <input type="checkbox" checked="@_langTicks.Contains(rec)" disabled="@locked" @onchange='() => ToggleLang(choice)' />
                                <span class="body">
                                    <span class="lbl">
                                        @I18nStrings.LanguageName(choice.PrimaryLang)
                                        @if (locked)
                                        {
                                            <span class="tag-installed">@(L["setup.models.installed"])</span>
                                        }
                                    </span>
                                    <span class="det">@rec · @FormatMb(OcrModelChoices.SizeMbOf(rec))</span>
                                    @if (choice.Variants.Count > 1)
                                    {
                                        <span class="det">
                                            @(L["setup.langs.variant"])
                                            <select value="@rec" @onchange='e => PickLangVariant(choice, e.Value?.ToString() ?? rec)'>
                                                @foreach (string variant in choice.Variants)
                                                {
                                                    <option value="@variant">@variant</option>
                                                }
                                            </select>
                                        </span>
                                    }
                                </span>
                                @if (_langTicks.Contains(rec))
                                {
                                    <label class="@(_activeLangPick == rec ? "use on" : "use")">
                                        <input type="radio" name="setup-langs" checked="@(_activeLangPick == rec)" @onchange='() => PickActiveLang(rec)' />
                                        @(L["setup.langs.read"])
                                    </label>
                                }
                            </li>
                        }
                    </ul>
                    <p class="setup-total">@(L.Fmt("setup.langs.total", FormatMb(_langTicks.Sum(ModelRowMissingMb))))</p>
                    <button type="button" class="rt-btn rt-btn-primary" disabled="@_busy" @onclick="ConfirmLanguagesAsync">@(L["setup.next"])</button>
                    break;

                case SetupStep.ChoosingLlmModels:
                    @* Bước 4 (spec 17-11 §6): model LLM — tick nhiều hoặc để trống; nhóm theo SizeClass
                       động; chấm "Dùng chính" = bản chạy; trống ⇒ bỏ qua bước tải runtime llama.cpp. *@
                    <p class="text-sm text-surface">@(L["setup.llm.title"]) <span class="rt-hint">@(L["setup.llm.hint"])</span></p>
                    <p class="setup-hintline">@(L["setup.llm.note"])</p>
                    @if (_llmLoadFailed)
                    {
                        <p class="setup-warn">@(L["setup.llm.loadFailed"])</p>
                        <button type="button" class="rt-btn" @onclick="ReloadLlmAsync">@(L["setup.error.retry"])</button>
                    }
                    else if (_llmModelsList.Count == 0)
                    {
                        <p class="setup-hintline">@(L["setup.llm.loading"])</p>
                    }
                    @foreach (IGrouping<string, LlmModelInfo> group in _llmModelsList.GroupBy(m => m.SizeClass))
                    {
                        <div class="setup-sect">
                            <span class="sect-lbl">@(L.Fmt("setup.llm.group", group.Key))</span>
                            <ul class="setup-choices">
                                @foreach (LlmModelInfo model in group)
                                {
                                    bool locked = _llmLocked.Contains(model.Name);
                                    <li>
                                        <input type="checkbox" checked="@_llmTicks.Contains(model.Name)" disabled="@locked" @onchange='() => ToggleLlm(model.Name)' />
                                        <span class="body">
                                            <span class="lbl">
                                                @model.Name
                                                @if (locked)
                                                {
                                                    <span class="tag-installed">@(L["setup.models.installed"])</span>
                                                }
                                            </span>
                                            <span class="det">@model.Quant · @FormatSize(model.SizeBytes)</span>
                                            @if (!model.Installed && !model.Downloading)
                                            {
                                                <span class="det">@(L.Fmt("setup.models.willDownload", FormatSize(model.SizeBytes)))</span>
                                            }
                                        </span>
                                        @if (_llmTicks.Contains(model.Name))
                                        {
                                            <label class="@(_activeLlmPick == model.Name ? "use on" : "use")">
                                                <input type="radio" name="setup-llm" checked="@(_activeLlmPick == model.Name)" @onchange='() => PickActiveLlm(model.Name)' />
                                                @(L["setup.llm.use"])
                                            </label>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    <p class="setup-total">@(L.Fmt("setup.models.total", FormatMb(LlmTotalMb())))</p>
                    <button type="button" class="rt-btn rt-btn-primary" disabled="@_busy" @onclick="ConfirmLlmModelsAsync">@(L["setup.next"])</button>
                    break;

                case SetupStep.ConfirmingFlavorSwitch:
                    @* Amendment A2: wizard dừng chờ user xác nhận đổi flavor — KHÔNG có hành động nào
                       khác ngoài nút xác nhận (không sync nào xảy ra trước đó). *@
                    <p class="text-sm text-surface mb-1">@(L["setup.flavorSwitch.title"])</p>
                    @if (Coordinator.PendingFlavorSwitch is { } pending)
                    {
                        <div class="flex flex-col gap-2">
                            <p class="rt-hint">@L.Fmt("setup.flavorSwitch.installed", FlavorLabel(pending.Installed))</p>
                            <p class="rt-hint">@L.Fmt("setup.flavorSwitch.target", FlavorLabel(pending.Target))</p>
                            <p class="rt-hint">@L.Fmt("setup.flavorSwitch.size", pending.Target == OcrFlavor.Gpu ? L["setup.flavorSwitch.sizeGpu"] : L["setup.flavorSwitch.sizeCpu"])</p>
                        </div>
                    }
                    <button type="button" class="rt-btn rt-btn-primary" disabled="@_busy" @onclick="ConfirmFlavorSwitchAsync">@(L["setup.flavorSwitch.confirm"])</button>
                    break;

                case SetupStep.Failed:
                    @* Lỗi từ coordinator là key i18n + args — resolve theo ngôn ngữ UI hiện hành. *@
                    <p class="text-sm" style="color: var(--rt-danger); white-space: pre-wrap; margin-bottom: 12px;">@(Coordinator.Error is { } error ? L.Fmt(error.Key, error.Args.ToArray()) : string.Empty)</p>
                    <div class="flex gap-2">
                        <button type="button" class="rt-btn rt-mini" disabled="@_busy" @onclick="RetryAsync">@(L["setup.error.retry"])</button>
                        @if (Coordinator.CanSwitchToCpuFlavor)
                        {
                            @* Lỗi cổng capability: card không chạy nổi bản GPU — đề nghị chuyển CPU
                               thẳng thay vì đường cụt (addendum §3). *@
                            <button type="button" class="rt-btn rt-btn-primary rt-mini" disabled="@_busy" @onclick="SwitchToCpuFlavorAsync">@(L["setup.error.switchCpu"])</button>
                        }
                        <button type="button" class="rt-btn rt-mini" disabled="@_busy" @onclick="ShowSkipConfirm">@(L["setup.error.skip"])</button>
                    </div>
                    break;

                default:
                    @* Các bước chạy (VerifyingFiles…Applying): tên bước + bar indeterminate (spec cho phép
                       fallback indeterminate); khi bước tải có tiến độ đo được → danh sách % + ETA (spec
                       17-11 §9). *@
                    <p class="text-sm text-surface">@(L[StepLabelKey(Coordinator.Step)])</p>
                    <div class="rt-setup-track" aria-hidden="true"><div class="rt-setup-bar"></div></div>
                    @if (Coordinator.Downloads.Count > 0)
                    {
                        <ul class="setup-downloads">
                            @foreach (SetupDownloadInfo download in Coordinator.Downloads)
                            {
                                (int? percent, TimeSpan? eta) = DownloadProgressText.Format(download.ReceivedBytes, download.TotalBytes, download.BytesPerSec);
                                <li>
                                    <span class="det mono">@download.Name</span>
                                    <span class="det">
                                        @(percent is { } p ? $"{p}%" : "…")
                                        @if (eta is { } t)
                                        {
                                            <text> · @(L.Fmt("setup.progress.eta", FormatEta(t)))</text>
                                        }
                                        @if (download.BytesPerSec == 0d)
                                        {
                                            <text> · @(L["setup.progress.retry"])</text>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    break;
            }
        </div>
    </div>

    @if (_showSkipConfirm)
    {
        @* Popup xác nhận của nút "Bỏ qua" (spec 2026-11-13): lớp phủ TRÊN modal (z 61 > 60, dưới
           toasts 70). [Thoát ReTran] = hành vi Skip cũ; [Bỏ qua thiết lập] = ẩn wizard + mở gate cho
           phiên này; [Quay lại] = đóng popup. *@
        <div class="fixed inset-0 flex items-center justify-center bg-black/50 p-4" style="z-index: 61;">
            <div role="dialog" aria-modal="true" aria-label="@(L["setup.skipConfirm.message"])"
                 class="rt-setup-modal w-full max-w-sm rounded-lg border border-surface bg-background p-4 shadow-xl">
                <p class="mb-3 text-sm text-surface">@(L["setup.skipConfirm.message"])</p>
                <div class="flex gap-2" style="flex-wrap: wrap;">
                    <button type="button" class="rt-btn rt-btn-danger rt-mini" disabled="@_busy" @onclick="ConfirmExit">@(L["setup.skipConfirm.exit"])</button>
                    <button type="button" class="rt-btn rt-btn-primary rt-mini" disabled="@_busy" @onclick="ConfirmSkipForSession">@(L["setup.skipConfirm.skip"])</button>
                    <button type="button" class="rt-btn rt-mini" disabled="@_busy" @onclick="BackFromSkipConfirm">@(L["setup.skipConfirm.back"])</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool _wizardActive;   // Wizard đã được start (hoặc đang chạy do rerun) — phân biệt với đường rẻ "đã xong".
    private bool _busy;           // Chặn bấm chồng các nút xác nhận/thử lại.
    private bool _showSkipConfirm; // Popup [Thoát ReTran]/[Bỏ qua thiết lập]/[Quay lại] đang mở (spec 2026-11-13).

    // Ba màn hỏi vòng 2 (spec 17-11): state nhập liệu, khởi tạo 1 lần mỗi lần VÀO màn từ preselect
    // thực tế (filesystem + settings); rời màn reset để lượt rerun sau lấy lại đúng thực tế.
    private HashSet<string> _installedModels = [];
    private bool _modelsInit;
    private List<string> _detTicks = [];
    private HashSet<string> _detLocked = [];
    private string _activeDetPick = "";
    private List<string> _recTicks = [];
    private HashSet<string> _recLocked = [];
    private string _activeRecPick = "";
    private bool _langsInit;
    private List<string> _langTicks = [];
    private HashSet<string> _langLocked = [];
    private string? _activeLangPick;
    private readonly Dictionary<string, string> _langVariantPick = new(StringComparer.Ordinal);
    private bool _llmInit;
    private IReadOnlyList<LlmModelInfo> _llmModelsList = [];
    private bool _llmLoadFailed;
    private List<string> _llmTicks = [];
    private HashSet<string> _llmLocked = [];
    private string? _activeLlmPick;

    private string ModalTitle => L["setup.title"];

    protected override void OnInitialized()
    {
        Coordinator.Changed += OnChanged;
        // Modal được mount lại (điều hướng qua lại) trong khi wizard đang đứng sẵn ở một màn hỏi →
        // khởi tạo state nhập liệu ngay; Changed có thể không bắn thêm khi đang pause.
        if (Coordinator.Step == SetupStep.ChoosingOcrModels) EnsureModelsState();
        if (Coordinator.Step == SetupStep.ChoosingLanguages) EnsureLangsState();
        if (Coordinator.Step == SetupStep.ChoosingLlmModels) _ = EnsureLlmStateAsync();
        if (!_wizardActive)
        {
            SetupState state = SetupState.Load();
            // Đường rẻ (spec §5.9): chỉ kiểm tra file/thư mục — không probe Python.
            if (SetupState.NeedsSetup(state, SetupPaths.VenvPythonExe, SetupPaths.ModelsDir))
            {
                _wizardActive = true;
                // Bước Checking chạy WMI + probe mạng đồng bộ (seam sync theo design) — đưa ra khỏi
                // UI thread để app start không bị đơ.
                _ = Task.Run(() => Coordinator.StartAsync());
            }
        }
    }

    // Changed bắn từ luồng nền (uv sync, poll model, restart core) — marshal về UI thread trước khi
    // re-render; mọi publish ngoài Done nghĩa là wizard đang chạy/chờ → modal phải hiện (đường rerun
    // start wizard từ SettingsPanel, không qua component này).
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        if (!Coordinator.IsComplete) _wizardActive = true;
        if (Coordinator.Step == SetupStep.ChoosingOcrModels) EnsureModelsState();
        else _modelsInit = false;
        if (Coordinator.Step == SetupStep.ChoosingLanguages) EnsureLangsState();
        else _langsInit = false;
        if (Coordinator.Step == SetupStep.ChoosingLlmModels) _ = EnsureLlmStateAsync();
        else _llmInit = false;
        StateHasChanged();
    });

    public void Dispose() => Coordinator.Changed -= OnChanged;

    private static string FormatMb(double mb) => $"{mb:0.#} MB";

    // Kích thước model LLM: catalog ghi theo byte thập phân — hiện GB khi đủ lớn, còn lại MB.
    private static string FormatSize(long bytes) =>
        bytes >= 1_000_000_000 ? $"{bytes / 1_000_000_000.0:0.#} GB" : FormatMb(bytes / 1_048_576.0);

    private static string FlavorLabel(OcrFlavor flavor) => flavor == OcrFlavor.Gpu ? "GPU" : "CPU";

    // Checklist Checking (2026-11-15): class theo trạng thái + glyph tĩnh (Running dùng spinner riêng).
    private static string CheckItemClass(SetupCheckState state) => state switch
    {
        SetupCheckState.Pending => "pending",
        SetupCheckState.Running => "running",
        SetupCheckState.Ok => "ok",
        SetupCheckState.Warn => "warn",
        SetupCheckState.Fail => "fail",
        _ => "pending",
    };

    private static string CheckGlyph(SetupCheckState state) => state switch
    {
        SetupCheckState.Ok => "✓",
        SetupCheckState.Warn => "⚠",
        SetupCheckState.Fail => "✗",
        _ => "·",
    };

    // Bước → key i18n: các key theo brief là camelCase (verifyingFiles…) nên KHÔNG suy được từ
    // Step.ToString().ToLowerInvariant() (sẽ ra "verifyingfiles" — key thiếu, UI hiện nguyên key).
    private static string StepLabelKey(SetupStep step) => step switch
    {
        SetupStep.VerifyingFiles => "setup.step.verifyingFiles",
        SetupStep.Syncing => "setup.step.syncing",
        SetupStep.VerifyingSidecar => "setup.step.verifyingSidecar",
        SetupStep.DownloadingLlmRuntime => "setup.step.downloadingLlmRuntime",
        SetupStep.DownloadingModels => "setup.step.downloadingModels",
        SetupStep.Applying => "setup.step.applying",
        _ => "setup.checking",
    };

    // ── Bước 2 "Chọn model OCR" (det + rec, spec 17-11 §4) ────────────────────────────────────────

    // Preselect từ thực tế: model đã cài → tick + khoá; máy sạch → Small tự do; chấm "Dùng chính"
    // theo cặp trong settings khi model đó được tick (OcrModelChoices lo toàn bộ luật).
    private void EnsureModelsState()
    {
        if (_modelsInit) return;
        _modelsInit = true;
        _installedModels = OcrModelChoices.ScanInstalledModels(SetupPaths.ModelsDir);
        AppSettings settings = SettingsStore.Load();
        ModelPreselect dets = OcrModelChoices.PreselectModels(_installedModels, settings.OcrDet, OcrModelChoices.DetModels());
        ModelPreselect recs = OcrModelChoices.PreselectModels(_installedModels, settings.OcrRec, OcrModelChoices.RecModels());
        _detTicks = [.. dets.Ticked];
        _detLocked = [.. dets.Locked];
        _activeDetPick = dets.Active;
        _recTicks = [.. recs.Ticked];
        _recLocked = [.. recs.Locked];
        _activeRecPick = recs.Active;
    }

    // Nhãn dòng cỡ: tên + mô tả từ i18n; cỡ lạ (chưa có key) → hiện token trần (fallback, không vỡ UI).
    private string RowLabel(string modelName)
    {
        string token = OcrModelChoices.SizeToken(modelName);
        string nameKey = $"setup.tier.name.{token}";
        string name = L[nameKey];
        if (name == nameKey) return token;
        string descKey = $"setup.tier.desc.{token}";
        string desc = L[descKey];
        return desc == descKey ? name : $"{name} — {desc}";
    }

    private static string ModelMeta(string modelName) =>
        $"{modelName} · {FormatMb(OcrModelChoices.SizeMbOf(modelName))}";

    private float ModelRowMissingMb(string modelName) =>
        _installedModels.Contains(modelName) ? 0 : OcrModelChoices.SizeMbOf(modelName);

    private void ToggleDet(string modelName)
    {
        if (_detLocked.Contains(modelName)) return; // đã cài → checkbox disabled; nhánh này là chốt an toàn
        if (!_detTicks.Remove(modelName)) _detTicks.Add(modelName);
        if (_detTicks.Count > 0 && !_detTicks.Contains(_activeDetPick))
            _activeDetPick = OcrModelChoices.DetModels().First(_detTicks.Contains);
    }

    private void PickActiveDet(string modelName) => _activeDetPick = modelName;

    private void ToggleRec(string modelName)
    {
        if (_recLocked.Contains(modelName)) return;
        if (!_recTicks.Remove(modelName)) _recTicks.Add(modelName);
        if (_recTicks.Count > 0 && !_recTicks.Contains(_activeRecPick))
            _activeRecPick = OcrModelChoices.RecModels().First(_recTicks.Contains);
    }

    private void PickActiveRec(string modelName) => _activeRecPick = modelName;

    private async Task ConfirmOcrModelsAsync()
    {
        if (_busy || _detTicks.Count == 0 || _recTicks.Count == 0) return;
        _busy = true;
        try
        {
            await Coordinator.ContinueWithOcrModelsAsync(_detTicks, _activeDetPick, _recTicks, _activeRecPick);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ── Bước 3 "Ngôn ngữ" (spec 17-11 §5) ────────────────────────────────────────────────────────

    // Preselect từ thực tế: rec legacy đã cài → tick + khoá; "Đọc chính" theo rec trong settings khi
    // rec đó nằm trong các dòng đã tick; trả lời trống hoàn toàn là hợp lệ.
    private void EnsureLangsState()
    {
        if (_langsInit) return;
        _langsInit = true;
        _installedModels = OcrModelChoices.ScanInstalledModels(SetupPaths.ModelsDir);
        (IReadOnlyList<string> ticked, IReadOnlyList<string> locked, string? active) =
            OcrModelChoices.PreselectLanguages(_installedModels, SettingsStore.Load().OcrRec);
        _langTicks = [.. ticked];
        _langLocked = [.. locked];
        _activeLangPick = active;
        _langVariantPick.Clear();
        foreach (LanguageChoice choice in OcrModelChoices.LanguageChoices())
            _langVariantPick[choice.PrimaryLang] = OcrModelChoices.DefaultVariant(choice, _installedModels);
    }

    private void ToggleLang(LanguageChoice choice)
    {
        string rec = _langVariantPick[choice.PrimaryLang];
        if (_langLocked.Contains(rec)) return;
        if (!_langTicks.Remove(rec)) _langTicks.Add(rec);
        if (_activeLangPick is not null && !_langTicks.Contains(_activeLangPick))
            _activeLangPick = _langTicks.Count > 0 ? _langTicks[0] : null;
    }

    private void PickActiveLang(string rec) => _activeLangPick = rec;

    // Đổi "Bản" của một dòng: giữ nguyên tick/khoá/chấm nếu dòng đó đang được chọn.
    private void PickLangVariant(LanguageChoice choice, string newRec)
    {
        string oldRec = _langVariantPick[choice.PrimaryLang];
        if (oldRec == newRec) return;
        _langVariantPick[choice.PrimaryLang] = newRec;
        int index = _langTicks.IndexOf(oldRec);
        if (index >= 0) _langTicks[index] = newRec;
        if (_langLocked.Remove(oldRec) && _installedModels.Contains(newRec)) _langLocked.Add(newRec);
        if (_activeLangPick == oldRec) _activeLangPick = newRec;
    }

    private async Task ConfirmLanguagesAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Coordinator.ContinueWithLanguagesAsync(_langTicks, _activeLangPick);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ── Bước 4 "Chọn model LLM" (spec 17-11 §6) ──────────────────────────────────────────────────

    // Danh sách đọc từ Core (llm.models.list — Core sống từ lúc app start); lỗi/mất Core ⇒ cờ để UI
    // hiện "không đọc được danh sách" nhưng không chặn bước (để trống vẫn hợp lệ).
    private async Task EnsureLlmStateAsync()
    {
        if (_llmInit) return;
        _llmInit = true;
        try
        {
            _llmModelsList = await Pipeline.ListLlmModelsAsync(CancellationToken.None);
            _llmLoadFailed = false;
        }
        catch (Exception)
        {
            _llmModelsList = [];
            _llmLoadFailed = true;
        }

        // Danh sách về SAU lượt render đầu của màn (await) → phải vẽ lại nếu không UI kẹt "đang nạp…".
        await InvokeAsync(StateHasChanged);

        _llmTicks = [];
        _llmLocked = [];
        _activeLlmPick = null;
        if (_llmModelsList.Count > 0)
        {
            (IReadOnlyList<string> ticked, IReadOnlyList<string> locked, string? active) =
                OcrModelChoices.PreselectLlmModels(
                    _llmModelsList.Where(m => m.Installed).Select(m => m.Name).ToList(),
                    SettingsStore.Load().LlmActiveModel,
                    _llmModelsList.Select(m => m.Name).ToList());
            _llmTicks = [.. ticked];
            _llmLocked = [.. locked];
            _activeLlmPick = active;
        }
    }

    // Nút "Thử lại" khi đọc danh sách LLM thất bại — đọc lại từ Core (bước vẫn để trống được).
    private async Task ReloadLlmAsync()
    {
        _llmInit = false;
        await EnsureLlmStateAsync();
    }

    private void ToggleLlm(string modelName)
    {
        if (_llmLocked.Contains(modelName)) return;
        if (!_llmTicks.Remove(modelName)) _llmTicks.Add(modelName);
        if (_llmTicks.Count == 0) _activeLlmPick = null;
        else if (_activeLlmPick is null || !_llmTicks.Contains(_activeLlmPick)) _activeLlmPick = _llmTicks[0];
    }

    private void PickActiveLlm(string modelName) => _activeLlmPick = modelName;

    private double LlmTotalMb() => _llmTicks
        .Select(name => _llmModelsList.FirstOrDefault(m => m.Name == name))
        .Where(m => m is { Installed: false, Downloading: false })
        .Sum(m => m!.SizeBytes) / (1024.0 * 1024.0);

    private async Task ConfirmLlmModelsAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Coordinator.ContinueWithLlmModelsAsync(_llmTicks, _activeLlmPick);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ETA người-đọc-được: dưới 90 giây hiện giây, còn lại hiện phút (đơn vị nằm ở i18n).
    private string FormatEta(TimeSpan eta) =>
        eta.TotalSeconds < 90
            ? L.Fmt("setup.progress.seconds", Math.Max(1, Math.Ceiling(eta.TotalSeconds)).ToString("0"))
            : L.Fmt("setup.progress.minutes", Math.Ceiling(eta.TotalMinutes).ToString("0"));

