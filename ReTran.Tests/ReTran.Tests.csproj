<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows10.0.19041.0: must match ReTran.App's Windows TFM (NU1201 otherwise);
         ReTran.Core is Windows-only too, so this covers both references. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The referenced MAUI app brings transitive Maui targets (Resizetizer) that fail in a plain test project. -->
    <UseMaui>false</UseMaui>
    <EnableMauiImageProcessing>false</EnableMauiImageProcessing>
    <!-- xUnit v3 test projects are executables (self-hosted runner). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReTran.Core\ReTran.Core.csproj" />
    <ProjectReference Include="..\ReTran.App\ReTran.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile UpdateStager.cs directly because the updater is an exe — same pattern as router-balancing; Program.cs deliberately NOT linked.
         Compile trực tiếp vì updater là exe — theo pattern router-balancing; KHÔNG link Program.cs. -->
    <Compile Include="..\ReTran.Updater\UpdateStager.cs" Link="Update\UpdateStager.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>